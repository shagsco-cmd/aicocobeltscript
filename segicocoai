-- Best Token Finder for current active field (supports maxRadius)
local function getBestToken(targetField, maxRadius)
    local hum, hrp = getCharacterComponents()
    if not hum or not hrp then return nil, 0 end

    local collectibles = Workspace:FindFirstChild("Collectibles")
    if not collectibles then return nil, 0 end

    local bestToken = nil
    local shortestDist = math.huge
    local nearbyCount = 0

    for _, c in ipairs(collectibles:GetChildren()) do
        if c:IsA("BasePart") then
            local frontDecal = c:FindFirstChild("FrontDecal")
            local isFaded = c.Transparency >= 0.6 or (frontDecal and frontDecal.Transparency >= 0.6)

            if not isFaded then
                local inField = true
                if Config.LockToField then
                    inField = isInsideField(c.Position, targetField)
                end

                if inField then
                    nearbyCount = nearbyCount + 1
                    local distToPlayer = (c.Position - hrp.Position).Magnitude
                    if (not maxRadius or distToPlayer <= maxRadius) and distToPlayer < shortestDist then
                        shortestDist = distToPlayer
                        bestToken = c
                    end
                end
            end
        end
    end

    Stats.NearbyTokens = nearbyCount
    return bestToken, shortestDist
end

-- Main Automation Loop
local running = true
local lastPos = nil
local stuckTimer = 0
local lastUiUpdate = 0
local returningToCenter = false
local roamAngle = 0

task.spawn(function()
    while running do
        task.wait(0.025)

        local hum, hrp = getCharacterComponents()

        -- Tween sırasında token toplamayı ve yürümeyi tamamen durdur
        if Stats.IsTweening then
            if hum then
                hum:Move(Vector3.zero, false)
            end
            if tick() - lastUiUpdate > 0.3 then
                lastUiUpdate = tick()
                updateStatusUI()
            end
            continue
        end

        -- Hız Ayarlaması (Combo veya tween sırasında değilken)
        if hum and Config.CustomSpeedEnabled and not comboWasActive then
            hum.WalkSpeed = Config.CustomSpeed
        end

        if Config.Enabled and hum and hrp and hum.Health > 0 then
            -- DOĞRUDAN EKRANDAKİ BUFF'IN ÜZERİNDEKİ SAYACI OKU (Örn: 20, 34, 40)
            local currentBeltStack = getLiveCoconutBeltStack()
            Stats.CoconutProgress = currentBeltStack

            local inComboFieldMode = (Stats.ComboState == "IN_COMBO_FIELD" or Stats.ComboState == "WAITING_FOR_0X")
            local currentTargetField = (inComboFieldMode and Config.ComboField) or Config.SelectedField
            local fieldCenter = getFieldCenter(currentTargetField)
            local amInsideField = isInsideField(hrp.Position, currentTargetField)

            -- Combo tarlası içindeyken sayaç takibi
            if inComboFieldMode then
                if currentBeltStack > highestStackInComboField then
                    highestStackInComboField = currentBeltStack
                end

                -- Eğer 35+ stack görüldükten sonra sayaç 0 olduysa veya 40'a ulaştıysa COMBO TETİKLENMİŞTİR:
                if (highestStackInComboField >= Config.CoconutThreshold and currentBeltStack == 0 and not comboWasActive) or currentBeltStack >= 40 then
                    if not comboTriggered then
                        comboTriggered = true
                        comboTriggerTime = tick()
                        Stats.ComboState = "WAITING_FOR_0X"
                    end
                end
            end

            -- ========================================================
            -- 1. COCONUT COMBO & ÇOKLU TARLA PASLAŞMA SİSTEMİ
            -- ========================================================
            local ourCombo, otherCombo, anyComboExists, maxPoints = getComboCoconutsInfo(currentTargetField)
            if maxPoints > maxComboSeen then
                maxComboSeen = maxPoints
            end

            if Config.CoconutBeltEnabled and anyComboExists then
                comboWasActive = true
                comboTriggered = false
                lastComboSeenTime = tick()

                if ourCombo then
                    -- 1A: Coconut BİZİM TARLAMIZDA! Yakala ve sabit kal!
                    if ourCombo.Points == 0 then
                        hasCaughtZeroX = true
                        Stats.Status = "⚡ 🥥 0x Bizim Alanda - Süzülünüyor & Bekleniyor!"
                    else
                        Stats.Status = string.format("⚡ 🥥 %s Bizim Alanda (%s) - Süzülünüyor!", ourCombo.Text, currentTargetField)
                    end

                    -- HAREKET ŞEKLİ: Kullanıcının belirlediği Combo Tween Hızı (stud/s) ile süzülür
                    if Config.ComboMovementMode == "Anında Işınlanma (TP)" then
                        hrp.CFrame = CFrame.new(ourCombo.Position.X, hrp.Position.Y, ourCombo.Position.Z)
                        hrp.Velocity = Vector3.zero
                        hum:Move(Vector3.zero, false)
                    else
                        local comboSpeed = Config.ComboTweenSpeed or Config.TweenSpeed or 95
                        tweenToGroundTarget(ourCombo.Position, comboSpeed)
                        hum:Move(Vector3.zero, false)
                    end

                    if tick() - lastUiUpdate > 0.25 then
                        lastUiUpdate = tick()
                        updateStatusUI()
                    end
                    task.wait(0.03)
                    continue -- KESİNLİKLE TOKEN TOPLAMA, HALKADA BEKLE!

                elseif otherCombo then
                    -- 1B: Coconut BAŞKA ALANDA (Örn: Diğer hesap Pepper'da, coconut oraya gitti)!
                    -- ASLA ORADAKİ COCONUTA IŞINLANMA! KENDİ TARLANDAN AYRILMA, SIRANI BEKLE!
                    hum:Move(Vector3.zero, false)
                    hrp.Velocity = Vector3.zero
                    Stats.Status = string.format("🥥 Coconut %s Alanında (%s) | Bizim Tarlada Sıra Bekleniyor...", otherCombo.Field or "Başka Alanda", otherCombo.Text)

                    if tick() - lastUiUpdate > 0.25 then
                        lastUiUpdate = tick()
                        updateStatusUI()
                    end
                    task.wait(0.03)
                    continue -- ASIL ALANA DÖNME, KENDİ ALANINDA SABİT BEKLE!
                end

            elseif Config.CoconutBeltEnabled and comboTriggered and not comboWasActive then
                -- 40. Coconut tüketildi ve combo tetiklendi: 0x doğana kadar tarladan ayrılma!
                local waitElapsed = tick() - comboTriggerTime
                if waitElapsed < 12.0 then
                    Stats.Status = string.format("🔥 Combo Tetiklendi! 🥥 0x Bekleniyor... (%.1fs)", 12.0 - waitElapsed)
                    hum:Move(Vector3.zero, false)
                    hrp.Velocity = Vector3.zero
                    task.wait(0.03)
                    if tick() - lastUiUpdate > 0.25 then
                        lastUiUpdate = tick()
                        updateStatusUI()
                    end
                    continue -- 0X ÇIKANA KADAR TARLADAN AYRILMA, TOKEN ARAMA!
                else
                    comboTriggered = false
                end

            elseif Config.CoconutBeltEnabled and comboWasActive then
                -- Coconut havada paslaşılıyor veya son coconut alındı.
                -- İki tarla arası uçuş ve pas payı için 7.5 saniye bekle:
                local timeSinceCombo = tick() - lastComboSeenTime

                if timeSinceCombo < 7.5 and maxComboSeen < 100 then
                    Stats.Status = string.format("🥥 Sonraki Pas / Combo Bekleniyor... (%.1fs)", 7.5 - timeSinceCombo)
                    hum:Move(Vector3.zero, false)
                    hrp.Velocity = Vector3.zero
                    task.wait(0.03)
                    if tick() - lastUiUpdate > 0.25 then
                        lastUiUpdate = tick()
                        updateStatusUI()
                    end
                    continue -- YENİ COMBO COCONUT GELİRSE YAKALAMAK İÇİN ALANDA SABİT KAL!
                else
                    -- 7.5 saniye geçti ve başka combo coconut gelmedi (FAIL oldu) VEYA 100x tamamlandı!
                    local finishReason = (maxComboSeen >= 100 and "🏆 100x Max Combo Tamamlandı!") or string.format("✅ Combo Bitti (%dx'de Fail Oldu)!", maxComboSeen)
                    Stats.Status = finishReason .. " Asıl Alana Dönülüyor..."
                    updateStatusUI()

                    comboWasActive = false
                    comboTriggered = false
                    comboTriggerTime = 0
                    highestStackInComboField = 0
                    maxComboSeen = 0

                    if Config.ReturnToMainField and Config.SelectedField then
                        local mainCenter = getFieldCenter(Config.SelectedField)
                        if mainCenter then
                            Stats.ComboState = "FLYING_TO_MAIN"
                            safeTweenTo(mainCenter, function()
                                Stats.ComboState = "NORMAL"
                                Stats.Status = "Asıl Alana Dönüldü, Farming Devam Ediyor"
                                hasCaughtZeroX = false
                            end)
                            continue
                        end
                    end
                    Stats.ComboState = "NORMAL"
                    hasCaughtZeroX = false
                end

            elseif Config.CoconutBeltEnabled and Stats.ComboState == "NORMAL" and currentBeltStack >= Config.CoconutThreshold then
                -- SADECE VE SADECE EKRANDAKİ SAYI EŞİĞE (Örn: 35) ULAŞTIĞINDA GEÇİŞ YAP!
                if Config.ComboField and Config.ComboField ~= Config.SelectedField then
                    local comboCenter = getFieldCenter(Config.ComboField)
                    local amInsideCombo = isInsideField(hrp.Position, Config.ComboField)

                    if not amInsideCombo and comboCenter then
                        Stats.ComboState = "FLYING_TO_COMBO"
                        highestStackInComboField = currentBeltStack
                        comboTriggered = false
                        comboWasActive = false
                        hasCaughtZeroX = false
                        maxComboSeen = 0
                        Stats.Status = string.format("Sayaç %d/40! %s Alanına Gidiliyor...", currentBeltStack, Config.ComboField)
                        updateStatusUI()

                        safeTweenTo(comboCenter, function()
                            Stats.ComboState = "IN_COMBO_FIELD"
                            Stats.Status = Config.ComboField .. " Alanında 40. Coconut Bekleniyor..."
                        end)
                        continue
                    else
                        Stats.ComboState = "IN_COMBO_FIELD"
                        highestStackInComboField = currentBeltStack
                    end
                end
            end

            -- ========================================================
            -- 2. STAR SHOWER (KÜÇÜK YEŞİL) & NORMAL COCONUT (BÜYÜK YEŞİL) TWEEN
            -- ========================================================
            local targetGreenDisk = nil
            local diskType = ""
            local diskTweenSpeed = 100

            -- Kullanıcı isteği: Sadece Star Shower (küçük yeşil) süzülür!
            if Config.StarShowerTweenEnabled then
                local starDiskPos = getActiveStarShowerDisk(currentTargetField)
                if starDiskPos then
                    targetGreenDisk = starDiskPos
                    diskType = "⭐ Star Shower (Küçük Yeşil)"
                    diskTweenSpeed = Config.StarShowerTweenSpeed or 100
                end
            end

            -- Eğer star shower yoksa ve normal coconut tween'i açılmışsa:
            if not targetGreenDisk and Config.FastTweenToNormalCoconut then
                local cocoDiskPos = getActiveCoconutDisk(currentTargetField)
                if cocoDiskPos then
                    targetGreenDisk = cocoDiskPos
                    diskType = "🥥 Normal Coconut (Büyük Yeşil)"
                    diskTweenSpeed = Config.NormalCoconutTweenSpeed or 100
                end
            end

            if targetGreenDisk then
                local dist = (hrp.Position - targetGreenDisk).Magnitude
                if dist > 2.0 then
                    Stats.Status = diskType .. " Süzülünüyor..."
                    tweenToGroundTarget(targetGreenDisk, diskTweenSpeed)
                end

                hum:Move(Vector3.zero, false)
                hrp.Velocity = Vector3.zero
                Stats.Status = diskType .. " Bekleniyor / Alınıyor..."

                if tick() - lastUiUpdate > 0.25 then
                    lastUiUpdate = tick()
                    updateStatusUI()
                end
                task.wait(0.03)
                continue -- Token toplamayı durdur, yıldızı al!
            end

            -- ========================================================
            -- 3. NORMAL VEYA COMBO ALANI MERKEZ ODAKLI TOKEN FARMING
            -- (HEP MERKEZDE GEZİNİR, KÖŞEYE GİDERSE TOKENİ ALIP HEMEN DÖNER)
            -- ========================================================
            if Config.LockToField and not amInsideField and fieldCenter then
                if Config.AutoTweenToField then
                    safeTweenTo(fieldCenter)
                    continue
                else
                    Stats.Status = currentTargetField .. " Alanına Yürünüyor..."
                    local walkTarget = Vector3.new(fieldCenter.X, hrp.Position.Y, fieldCenter.Z)
                    local dir = (walkTarget - hrp.Position)
                    if dir.Magnitude > 0.1 then
                        hum:Move(dir.Unit, false)
                    end
                end
            else
                local distFromCenter = fieldCenter and (hrp.Position - fieldCenter).Magnitude or 0

                -- Köşeye gittiyse ve o köşedeki yakın tokenler bittiyse -> HEMEN MERKEZE DÖN!
                if fieldCenter and distFromCenter > 30 and not returningToCenter then
                    local nearToken, _ = getBestToken(currentTargetField, 14)
                    if not nearToken then
                        returningToCenter = true
                    end
                end

                if returningToCenter and fieldCenter then
                    if distFromCenter <= 18 then
                        returningToCenter = false
                    else
                        Stats.Status = "🌸 Köşe Tokenleri Alındı -> Merkeze Dönülüyor..."
                        local dir = (fieldCenter - hrp.Position)
                        hum:Move(Vector3.new(dir.X, 0, dir.Z).Unit, false)
                        task.wait(0.02)
                        continue
                    end
                end

                -- Token Ara
                local token, dist = getBestToken(currentTargetField)

                if token and token.Parent == Workspace:FindFirstChild("Collectibles") then
                    Stats.CurrentTarget = token
                    Stats.Status = string.format("⚡ Token'a Koşuluyor (%.1fm)", dist)

                    -- Direkt hız vektörü ile sıfır gecikmeli atılma
                    local dir = (Vector3.new(token.Position.X, hrp.Position.Y, token.Position.Z) - hrp.Position)
                    if dir.Magnitude > 0.1 then
                        hum:Move(dir.Unit, false)
                    end

                    -- Takılma kontrolü
                    if lastPos then
                        local movedDist = (hrp.Position - lastPos).Magnitude
                        if movedDist < 0.5 then
                            stuckTimer = stuckTimer + 0.03
                            if stuckTimer >= 0.8 and Config.AutoJump then
                                hum.Jump = true
                                stuckTimer = 0
                            end
                        else
                            stuckTimer = 0
                        end
                    end
                    lastPos = hrp.Position

                    -- Token alma mesafesi: 6.5 stud (anında toplama)
                    if dist <= 6.5 then
                        Stats.CollectedCount = Stats.CollectedCount + 1
                        Stats.Status = "Token Toplandı!"
                    end
                else
                    -- ALANDA TOPLANACAK TOKEN YOKSA:
                    -- MERKEZDE ÇİÇEKLERİN ÜZERİNDE SÜREKLİ DÖNEREK DEVRİYE GEZ (ROAM)
                    Stats.CurrentTarget = nil
                    if Config.RoamWhenNoTokens and fieldCenter then
                        roamAngle = (roamAngle + 0.35) % (math.pi * 2)
                        local offset = Vector3.new(math.cos(roamAngle) * (Config.CenterRoamRadius or 18), 0, math.sin(roamAngle) * (Config.CenterRoamRadius or 18))
                        local roamPoint = fieldCenter + offset
                        local dir = (roamPoint - hrp.Position)
                        if dir.Magnitude > 0.1 then
                            hum:Move(Vector3.new(dir.X, 0, dir.Z).Unit, false)
                        end
                        Stats.Status = "🌸 Merkezde Çiçekler Üzerinde Geziniyor..."
                    else
                        Stats.Status = "Yeni Token Bekleniyor..."
                        hum:Move(Vector3.zero, false)
                    end
                end
            end
        end

        if tick() - lastUiUpdate > 0.35 then
            lastUiUpdate = tick()
            updateStatusUI()
        end
    end
end)

