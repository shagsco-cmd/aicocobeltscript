            local dd = parent:FindFirstChild("WindUI/Dropdowns")
            if dd and dd:IsA("ScreenGui") then dd.Enabled = visible end
            local tt = parent:FindFirstChild("WindUI/Tooltips")
            if tt and tt:IsA("ScreenGui") then tt.Enabled = visible end
        end
        if visible then
