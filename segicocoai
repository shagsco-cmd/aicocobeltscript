-- Helper: Get Center Position of Any Field
local function getFieldCenter(fieldName)
    if fieldName and fieldName ~= "Mevcut Konum (Otomatik)" and FlowerZonesFolder then
        local fieldPart = FlowerZonesFolder:FindFirstChild(fieldName)
        if fieldPart and fieldPart:IsA("BasePart") then
            return fieldPart.Position
        end
    end
    return Config.AnchorPosition
end

-- Helper: Check if a position is inside a specific field
local function isInsideField(pos, fieldName)
    if not fieldName or fieldName == "Mevcut Konum (Otomatik)" then
        if Config.AnchorPosition then
            return (pos - Config.AnchorPosition).Magnitude <= Config.MaxDistance
        end
        return true
    end

    if not FlowerZonesFolder then return true end
    local fieldPart = FlowerZonesFolder:FindFirstChild(fieldName)
    if not fieldPart or not fieldPart:IsA("BasePart") then return true end

    local localPos = fieldPart.CFrame:PointToObjectSpace(pos)
    local half = fieldPart.Size / 2
    return math.abs(localPos.X) <= (half.X + 8) and math.abs(localPos.Z) <= (half.Z + 8)
end

-- Helper: Get a safe random point inside a field for roaming when no tokens
local function getRandomFieldPoint(fieldName)
    if fieldName and fieldName ~= "Mevcut Konum (Otomatik)" and FlowerZonesFolder then
        local fieldPart = FlowerZonesFolder:FindFirstChild(fieldName)
        if fieldPart and fieldPart:IsA("BasePart") then
            local size = fieldPart.Size
            local rx = (math.random() - 0.5) * (size.X * 0.75)
            local rz = (math.random() - 0.5) * (size.Z * 0.75)
            local targetCF = fieldPart.CFrame * CFrame.new(rx, 3, rz)
            return targetCF.Position
        end
    end

    local hum, hrp = getCharacterComponents()
    local center = Config.AnchorPosition or (hrp and hrp.Position)
    if center then
        local maxDist = (Config.MaxDistance or 100) * 0.6
        local rx = (math.random() - 0.5) * 2 * maxDist
        local rz = (math.random() - 0.5) * 2 * maxDist
        return center + Vector3.new(rx, 0, rz)
    end
    return nil
end

