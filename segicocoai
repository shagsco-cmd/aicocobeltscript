if FlowerZonesFolder then
    local rawFields = {}
    for _, f in ipairs(FlowerZonesFolder:GetChildren()) do
        if f:IsA("BasePart") then
            -- Exclude out-of-bounds test fields
            if math.abs(f.Position.X) < 1500 and math.abs(f.Position.Z) < 1500 then
                table.insert(rawFields, f.Name)
            end
        end
    end
    table.sort(rawFields)
    for _, name in ipairs(rawFields) do
        table.insert(FieldList, name)
    end
end

-- Detect current field of player
local function getCurrentField()
    local char = LocalPlayer.Character
    if not char then return nil end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp or not FlowerZonesFolder then return nil end

    for _, field in ipairs(FlowerZonesFolder:GetChildren()) do
        if field:IsA("BasePart") then
            local localPos = field.CFrame:PointToObjectSpace(hrp.Position)
            local half = field.Size / 2
            if math.abs(localPos.X) <= half.X + 8 and math.abs(localPos.Z) <= half.Z + 8 and math.abs(localPos.Y) <= half.Y + 25 then
                return field.Name
            end
        end
    end
    return nil
end

-- Helper: Get which field name a position belongs to
local function getFieldNameAt(pos)
    if not FlowerZonesFolder or not pos then return nil end
    for _, field in ipairs(FlowerZonesFolder:GetChildren()) do
        if field:IsA("BasePart") then
            local localPos = field.CFrame:PointToObjectSpace(pos)
            local half = field.Size / 2
            if math.abs(localPos.X) <= (half.X + 8) and math.abs(localPos.Z) <= (half.Z + 8) then
                return field.Name
            end
        end
    end
    return nil
end

