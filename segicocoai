local function getLiveCoconutBeltStack()
    local lp = Players.LocalPlayer
    if not lp then return 0 end
    local sg = lp.PlayerGui:FindFirstChild("ScreenGui")
    if not sg then return 0 end

    for _, tg in ipairs(sg:GetChildren()) do
        if tg.Name == "TileGrid" then
            for _, tile in ipairs(tg:GetChildren()) do
                local icon = tile:FindFirstChildWhichIsA("ImageLabel", true) or tile:FindFirstChildWhichIsA("ImageButton", true)
                if icon and icon.Image and string.find(tostring(icon.Image), "17354253598") then
                    local label = tile:FindFirstChildWhichIsA("TextLabel", true)
                    if label and label.Text and label.Text ~= "" then
                        local num = tonumber(label.Text:match("%d+"))
                        if num then
                            return num
                        end
                    end
                end
            end
        end
    end
    return 0
end

-- Helper: Scan for active combo coconut disks and differentiate between our field vs other fields
local function getComboCoconutsInfo(ourField)
    local particles = Workspace:FindFirstChild("Particles")
    if not particles then
        return nil, nil, false, 0
    end

    local ourCombo = nil
    local otherCombo = nil
    local anyComboExists = false
    local maxPoints = 0

    for _, obj in ipairs(particles:GetChildren()) do
        if obj:IsA("BasePart") and (obj.Name == "WarningDisk" or obj.Name == "AreaRing") then
            local guiAttach = obj:FindFirstChild("GuiAttach") or obj:FindFirstChildWhichIsA("BillboardGui", true)
            if guiAttach then
                local textLabel = guiAttach:FindFirstChildWhichIsA("TextLabel", true)
                if textLabel and textLabel.Text and (textLabel.Text:find("🥥") or textLabel.Text:find("x") or textLabel.Text:find("0")) then
                    anyComboExists = true
                    local points = tonumber(textLabel.Text:match("%d+")) or 0
                    if points > maxPoints then
                        maxPoints = points
                    end

                    local fieldName = getFieldNameAt(obj.Position)
                    local comboData = {
                        Position = obj.Position,
                        Text = textLabel.Text,
                        Field = fieldName,
                        Points = points,
                    }

                    local inOurField = false
                    if ourField and ourField ~= "Mevcut Konum (Otomatik)" then
                        inOurField = isInsideField(obj.Position, ourField)
                    elseif ourField == "Mevcut Konum (Otomatik)" then
                        local hum, hrp = getCharacterComponents()
                        if hrp then
                            local myField = getCurrentField()
                            if myField then
                                inOurField = isInsideField(obj.Position, myField)
                            else
                                inOurField = (obj.Position - hrp.Position).Magnitude <= Config.MaxDistance
                            end
                        end
                    end

                    if inOurField then
                        ourCombo = comboData
                    else
                        otherCombo = comboData
                    end
                end
            end
        end
    end

    return ourCombo, otherCombo, anyComboExists, maxPoints
end

-- Helper: Find Active Green Warning Disks on the GROUND ONLY inside active field!
local function getActiveGreenWarningDisk(currentField)
    local hum, hrp = getCharacterComponents()
    if not hrp then return nil end

    local particles = Workspace:FindFirstChild("Particles")
    if not particles then return nil end

    local bestPos = nil
    local shortestDist = math.huge

    for _, obj in ipairs(particles:GetChildren()) do
        if obj:IsA("BasePart") and (obj.Name == "WarningDisk" or (obj.Name == "AreaRing" and obj.Color.G > 0.65)) then
            local guiAttach = obj:FindFirstChild("GuiAttach") or obj:FindFirstChildWhichIsA("BillboardGui", true)
            local isCombo = false
            if guiAttach then
                local textLabel = guiAttach:FindFirstChildWhichIsA("TextLabel", true)
                if textLabel and textLabel.Text and (textLabel.Text:find("🥥") or textLabel.Text:find("x") or textLabel.Text:find("0")) then
                    isCombo = true
                end
            end

            if not isCombo then
                local inField = true
                if Config.LockToField and currentField then
                    inField = isInsideField(obj.Position, currentField)
                end

                if inField then
                    local dist = (obj.Position - hrp.Position).Magnitude
                    if dist < shortestDist and dist <= Config.MaxDistance then
                        shortestDist = dist
                        bestPos = obj.Position
                    end
                end
            end
        end
    end

    return bestPos
end

-- Stop Active Tween cleanly
local function stopTween()
    tweenCancelRequested = true
    if activeTween then
        pcall(function() activeTween:Cancel() end)
        activeTween = nil
    end
    if activeBv then
        pcall(function() activeBv:Destroy() end)
        activeBv = nil
    end
    if activeBg then
        pcall(function() activeBg:Destroy() end)
        activeBg = nil
    end
    if noclipConnection then
        pcall(function() noclipConnection:Disconnect() end)
        noclipConnection = nil
    end

    local hum, hrp = getCharacterComponents()
    if hum then
        pcall(function()
            hum:Move(Vector3.zero, false)
            hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, true)
            hum:SetStateEnabled(Enum.HumanoidStateType.Freefall, true)
        end)
    end
    if hrp then
        hrp.Velocity = Vector3.zero
    end

    Stats.IsTweening = false
end

-- Direct Linear Tween for Field Transitions
local function safeTweenTo(targetPos, onComplete)
    stopTween()
    tweenCancelRequested = false

    local hum, hrp = getCharacterComponents()
    if not hum or not hrp or not targetPos then return end

    local startPos = hrp.Position
    local endPos = targetPos + Vector3.new(0, 3.5, 0)
    local totalDistance = (startPos - endPos).Magnitude

    if totalDistance < 5 then
        if onComplete then onComplete() end
        return
    end

    Stats.IsTweening = true
    Stats.Status = string.format("Alana Gidiliyor (%.0f stud)...", totalDistance)

    pcall(function()
        hum:Move(Vector3.zero, false)
        hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
        hum:SetStateEnabled(Enum.HumanoidStateType.Freefall, false)
        hum:ChangeState(Enum.HumanoidStateType.Running)
    end)

    activeBv = Instance.new("BodyVelocity")
    activeBv.Name = "DirectAntiGravity"
    activeBv.Velocity = Vector3.zero
    activeBv.MaxForce = Vector3.new(1e6, 1e6, 1e6)
    activeBv.Parent = hrp

    local dir = (endPos - startPos)
    local flatDir = Vector3.new(dir.X, 0, dir.Z)
    if flatDir.Magnitude < 0.1 then
        flatDir = hrp.CFrame.LookVector
    else
        flatDir = flatDir.Unit
    end

    activeBg = Instance.new("BodyGyro")
    activeBg.Name = "DirectUprightGyro"
    activeBg.MaxTorque = Vector3.new(1e6, 1e6, 1e6)
    activeBg.P = 10000
    activeBg.CFrame = CFrame.lookAt(startPos, startPos + flatDir)
    activeBg.Parent = hrp

    noclipConnection = RunService.Stepped:Connect(function()
        if not Stats.IsTweening or tweenCancelRequested then
            if noclipConnection then noclipConnection:Disconnect() end
            return
        end
        local char = LocalPlayer.Character
        if char then
            for _, part in ipairs(char:GetDescendants()) do
                if part:IsA("BasePart") then
                    part.CanCollide = false
                end
            end
        end
    end)

    local speed = Config.TweenSpeed or 95
    local duration = totalDistance / speed
    local targetCF = CFrame.lookAt(endPos, endPos + flatDir)

    task.spawn(function()
        activeTween = TweenService:Create(hrp, TweenInfo.new(duration, Enum.EasingStyle.Linear), { CFrame = targetCF })
        activeTween:Play()
        activeTween.Completed:Wait()

        if not tweenCancelRequested then
            Stats.Status = "Alana Ulaşıldı!"
            stopTween()
            if onComplete then
                onComplete()
            end
        else
            stopTween()
        end
    end)
end

-- Smooth Ground Level Linear Tween to Ground Disks
local function tweenToGroundTarget(targetPos, customSpeed)
    local hum, hrp = getCharacterComponents()
    if not hum or not hrp or not targetPos then return end

    local startPos = hrp.Position
    local endPos = Vector3.new(targetPos.X, hrp.Position.Y, targetPos.Z)
    local dist = (startPos - endPos).Magnitude
    if dist < 2.0 then
        hum:Move(Vector3.zero, false)
        hrp.Velocity = Vector3.zero
        return
    end

    Stats.IsTweening = true

    pcall(function()
        hum:Move(Vector3.zero, false)
        hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
        hum:SetStateEnabled(Enum.HumanoidStateType.Freefall, false)
        hum:ChangeState(Enum.HumanoidStateType.Running)
    end)

    local bv = Instance.new("BodyVelocity")
    bv.Velocity = Vector3.zero
    bv.MaxForce = Vector3.new(1e6, 1e6, 1e6)
    bv.Parent = hrp

    local dir = (endPos - startPos)
    local flatDir = Vector3.new(dir.X, 0, dir.Z)
    if flatDir.Magnitude < 0.1 then flatDir = hrp.CFrame.LookVector else flatDir = flatDir.Unit end
    local targetCF = CFrame.lookAt(endPos, endPos + flatDir)

    local speed = customSpeed or Config.TweenSpeed or 95
    local duration = math.clamp(dist / speed, 0.04, 3.5)

    local tw = TweenService:Create(hrp, TweenInfo.new(duration, Enum.EasingStyle.Linear), { CFrame = targetCF })
    tw:Play()
    tw.Completed:Wait()

    bv:Destroy()
    hrp.Velocity = Vector3.zero
    hum:Move(Vector3.zero, false)
    Stats.IsTweening = false
end

