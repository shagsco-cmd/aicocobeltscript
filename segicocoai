-- Toplanan tokenleri anlık belleğe alarak karakterin duraksamadan sonraki tokene kesintisiz koşmasını sağlar
local collectedTokensCache = {}

-- Best Token Finder for current active field (1. Öncelik: Token Link, 2. Öncelik: Red/Blue Boost, 3. Normal)
local function getBestToken(targetField, maxRadius)
    local hum, hrp = getCharacterComponents()
    if not hum or not hrp then return nil, 0, nil, nil end

    local collectibles = Workspace:FindFirstChild("Collectibles")
    if not collectibles then return nil, 0, nil, nil end

    -- 1. Öncelik: Token Link / Conversion Link
    local bestTokenLink = nil
    local shortestTokenLinkDist = math.huge

    -- 2. Öncelik: Red Boost / Blue Boost
    local bestBoost = nil
    local shortestBoostDist = math.huge
    local boostName = ""

    -- 3. Öncelik: Normal tokenler
    local bestNormalToken = nil
    local shortestNormalDist = math.huge

    local nearbyCount = 0
    local now = tick()

    for _, c in ipairs(collectibles:GetChildren()) do
        if c:IsA("BasePart") then
            -- Eğer token son 1.5 saniye içinde toplandıysa (server silene kadar) yoksay
            if not (collectedTokensCache[c] and (now - collectedTokensCache[c]) < 1.5) then
                local frontDecal = c:FindFirstChild("FrontDecal")
                -- BSS'de normal tokenlerin şeffaflığı ~0.7'dir; bu yüzden > 0.85 solmuş/yok olan tokendir
                local isFaded = c.Transparency > 0.85 or (frontDecal and frontDecal.Transparency > 0.85)

                if not isFaded then
                    local inField = true
                    if Config.LockToField then
                        inField = isInsideField(c.Position, targetField)
                    end

                    if inField then
                        nearbyCount = nearbyCount + 1
                        local distToPlayer = (c.Position - hrp.Position).Magnitude
                        if not maxRadius or distToPlayer <= maxRadius then
                            local tex = frontDecal and frontDecal.Texture and tostring(frontDecal.Texture)

                            -- 1. ÖNCELİK: Token Link veya Conversion Link (Tüm tokenleri çeker!)
                            local isTokenLink = false
                            if tex and (tex:find("1629547638") or tex:find("1874564120")) then
                                isTokenLink = true
                            end

                            -- 2. ÖNCELİK: Red Boost veya Blue Boost
                            local currentBoostType = nil
                            if tex then
                                if tex:find("1442859163") then
                                    currentBoostType = "Red Boost"
                                elseif tex:find("1442863423") then
                                    currentBoostType = "Blue Boost"
                                end
                            end

                            if isTokenLink then
                                if distToPlayer < shortestTokenLinkDist then
                                    shortestTokenLinkDist = distToPlayer
                                    bestTokenLink = c
                                end
                            elseif currentBoostType then
                                if distToPlayer < shortestBoostDist then
                                    shortestBoostDist = distToPlayer
                                    bestBoost = c
                                    boostName = currentBoostType
                                end
                            else
                                if distToPlayer < shortestNormalDist then
                                    shortestNormalDist = distToPlayer
                                    bestNormalToken = c
                                end
                            end
                        end
                    end
                end
            end
        end
    end

    Stats.NearbyTokens = nearbyCount

    -- 1. ÖNCELİK: TOKEN LINK (Tarladaki tüm tokenleri tek seferde vakumlar!)
    if bestTokenLink then
        return bestTokenLink, shortestTokenLinkDist, "LINK", "Token Link"
    -- 2. ÖNCELİK: RED BOOST / BLUE BOOST (Kullanıcı tercihi)
    elseif bestBoost then
        return bestBoost, shortestBoostDist, "BOOST", boostName
    -- 3. ÖNCELİK: DİĞER TÜM NORMAL TOKENLER
    elseif bestNormalToken then
        return bestNormalToken, shortestNormalDist, "NORMAL", "Token"
    else
        return nil, 0, nil, nil
    end
end

-- Main Automation Loop
local running = true
local lastPos = nil
local stuckTimer = 0
local lastUiUpdate = 0
local currentRoamTarget = nil
local lastRoamChange = 0
local isConverting = false
local hasTriggeredConvert = false

task.spawn(function()
    while running do
        task.wait(0.025)

        local hum, hrp = getCharacterComponents()

        -- Tween sırasında token toplamayı ve yürümeyi tamamen durdur
        if Stats.IsTweening then
            if hum then
                hum:Move(Vector3.zero, false)
            end
            if tick() - lastUiUpdate > 0.3 then
                lastUiUpdate = tick()
                updateStatusUI()
            end
            continue
        end

        -- Hız Ayarlaması (Combo veya tween sırasında değilken)
        if hum and Config.CustomSpeedEnabled and not comboWasActive then
            hum.WalkSpeed = Config.CustomSpeed
        end

        if Config.Enabled and hum and hrp and hum.Health > 0 then
            -- Pollen ve Çanta Kapasitesi Takibi (CoreStats)
            local coreStats = LocalPlayer:FindFirstChild("CoreStats")
            local currentPollen = (coreStats and coreStats:FindFirstChild("Pollen") and coreStats.Pollen.Value) or 0
            local currentCapacity = (coreStats and coreStats:FindFirstChild("Capacity") and coreStats.Capacity.Value) or 1
            local currentPollenPercent = math.clamp((currentPollen / math.max(currentCapacity, 1)) * 100, 0, 100)
            Stats.Pollen = currentPollen
            Stats.Capacity = currentCapacity
            Stats.PollenPercent = currentPollenPercent

            -- ========================================================
            -- 0. OTO BAL YAPMA (AUTO CONVERT) SİSTEMİ
            -- ========================================================
            if Config.AutoConvertEnabled then
                -- Çanta %100 (veya belirlenen eşik) dolduğunda dönüştürmeyi başlat
                if not isConverting and currentPollenPercent >= (Config.ConvertThreshold or 100) then
                    local myHive, hivePos = getPlayerHive()
                    if hivePos then
                        isConverting = true
                        hasTriggeredConvert = false
                        Stats.Converting = true
                        Stats.ConvertState = "FLYING_TO_HIVE"
                        Stats.Status = string.format("🍯 Çanta Doldu (%%%.1f)! Kovana Gidiliyor...", currentPollenPercent)
                        updateStatusUI()

                        safeTweenTo(hivePos, function()
                            Stats.ConvertState = "CONVERTING"
                            Stats.Status = "🍯 Kovana Ulaşıldı, Bal Yapma Başlatılıyor..."
                        end)
                        continue
                    end
                end

                -- Bal yapma / Kovanda dönüştürme modundaysak:
                if isConverting then
                    if Stats.ConvertState == "FLYING_TO_HIVE" or Stats.IsTweening then
                        continue
                    end

                    local myHive, hivePos = getPlayerHive()
                    if not hivePos then
                        isConverting = false
                        hasTriggeredConvert = false
                        Stats.Converting = false
                        Stats.ConvertState = "IDLE"
                        continue
                    end

                    -- Kovanda mıyız kontrol et (Kovan platformuna 15 stud yakınlık)
                    local distToHive = (hrp.Position - hivePos).Magnitude
                    if distToHive > 15 then
                        safeTweenTo(hivePos, function()
                            Stats.ConvertState = "CONVERTING"
                        end)
                        continue
                    end

                    -- Çanta TAMAMEN BOŞALDI MI? (pollen <= 0.5)
                    if currentPollen <= 0.5 then
                        isConverting = false
                        hasTriggeredConvert = false
                        Stats.Converting = false
                        Stats.ConvertState = "RETURNING_TO_FIELD"
                        Stats.Status = "✅ Çanta Tamamen Boşaltıldı! Tarlaya Dönülüyor..."
                        updateStatusUI()

                        local fieldCenter = getFieldCenter(Config.SelectedField)
                        if fieldCenter then
                            safeTweenTo(fieldCenter, function()
                                Stats.ConvertState = "IDLE"
                                Stats.Status = Config.SelectedField .. " Alanına Ulaşıldı, Farming Devam Ediyor"
                                updateStatusUI()
                            end)
                        else
                            Stats.ConvertState = "IDLE"
                        end
                        continue
                    else
                        -- Çanta henüz boşalmadı, kovan platformunda sabit kal!
                        hum:Move(Vector3.zero, false)
                        hrp.Velocity = Vector3.zero

                        -- KULLANICI İSTEĞİ: Kovandayken SADECE 1 KERE bal yapma komutu tetiklenir!
                        -- Tekrar tekrar basmak ToggleHoneyMaking olduğu için bal yapmayı iptal edip bozuyordu.
                        if not hasTriggeredConvert then
                            hasTriggeredConvert = true
                            pcall(function()
                                ReplicatedStorage.Events.PlayerHiveCommand:FireServer("ToggleHoneyMaking")
                            end)
                        end

                        Stats.Status = string.format("🍯 Bal Yapılıyor... Çanta: %%%.1f (%s / %s)", currentPollenPercent, formatNumber(currentPollen), formatNumber(currentCapacity))
                        if tick() - lastUiUpdate > 0.25 then
                            lastUiUpdate = tick()
                            updateStatusUI()
                        end
                        task.wait(0.03)
                        continue -- DÖNÜŞTÜRME BİTENE KADAR ASLA TOKEN VEYA COCONUT TOPLAMA!
                    end
                end
            end

            -- DOĞRUDAN EKRANDAKİ BUFF'IN ÜZERİNDEKİ SAYACI OKU (Örn: 20, 34, 40)
            local currentBeltStack = getLiveCoconutBeltStack()
            Stats.CoconutProgress = currentBeltStack

            local inComboFieldMode = (Stats.ComboState == "IN_COMBO_FIELD" or Stats.ComboState == "WAITING_FOR_0X")
            local currentTargetField = (inComboFieldMode and Config.ComboField) or Config.SelectedField
            local fieldCenter = getFieldCenter(currentTargetField)
            local amInsideField = isInsideField(hrp.Position, currentTargetField)

            -- Combo tarlası içindeyken sayaç takibi
            if inComboFieldMode then
                if currentBeltStack > highestStackInComboField then
                    highestStackInComboField = currentBeltStack
                end

                -- Eğer 35+ stack görüldükten sonra sayaç 0 olduysa veya 40'a ulaştıysa COMBO TETİKLENMİŞTİR:
                if (highestStackInComboField >= Config.CoconutThreshold and currentBeltStack == 0 and not comboWasActive) or currentBeltStack >= 40 then
                    if not comboTriggered then
                        comboTriggered = true
                        comboTriggerTime = tick()
                        Stats.ComboState = "WAITING_FOR_0X"
                    end
                end
            end

            -- ========================================================
            -- 1. COCONUT COMBO & ÇOKLU TARLA PASLAŞMA SİSTEMİ
            -- ========================================================
            local ourCombo, otherCombo, anyComboExists, maxPoints = getComboCoconutsInfo(currentTargetField)
            if maxPoints > maxComboSeen then
                maxComboSeen = maxPoints
            end

            if Config.CoconutBeltEnabled and anyComboExists then
                comboWasActive = true
                comboTriggered = false
                lastComboSeenTime = tick()

                if ourCombo then
                    -- 1A: Coconut BİZİM TARLAMIZDA! Yakala ve sabit kal!
                    if ourCombo.Points == 0 then
                        hasCaughtZeroX = true
                        Stats.Status = "⚡ 🥥 0x Bizim Alanda - Süzülünüyor & Bekleniyor!"
                    else
                        Stats.Status = string.format("⚡ 🥥 %s Bizim Alanda (%s) - Süzülünüyor!", ourCombo.Text, currentTargetField)
                    end

                    -- HAREKET ŞEKLİ: Kullanıcının belirlediği Combo Tween Hızı (stud/s) ile süzülür
                    if Config.ComboMovementMode == "Anında Işınlanma (TP)" then
                        hrp.CFrame = CFrame.new(ourCombo.Position.X, hrp.Position.Y, ourCombo.Position.Z)
                        hrp.Velocity = Vector3.zero
                        hum:Move(Vector3.zero, false)
                    else
                        local comboSpeed = Config.ComboTweenSpeed or Config.TweenSpeed or 95
                        tweenToGroundTarget(ourCombo.Position, comboSpeed)
                        hum:Move(Vector3.zero, false)
                    end

                    if tick() - lastUiUpdate > 0.25 then
                        lastUiUpdate = tick()
                        updateStatusUI()
                    end
                    task.wait(0.03)
                    continue -- KESİNLİKLE TOKEN TOPLAMA, HALKADA BEKLE!

                elseif otherCombo then
                    -- 1B: Coconut BAŞKA ALANDA (Örn: Diğer hesap Pepper'da, coconut oraya gitti)!
                    -- ASLA ORADAKİ COCONUTA IŞINLANMA! KENDİ TARLANDAN AYRILMA, SIRANI BEKLE!
                    hum:Move(Vector3.zero, false)
                    hrp.Velocity = Vector3.zero
                    Stats.Status = string.format("🥥 Coconut %s Alanında (%s) | Bizim Tarlada Sıra Bekleniyor...", otherCombo.Field or "Başka Alanda", otherCombo.Text)

                    if tick() - lastUiUpdate > 0.25 then
                        lastUiUpdate = tick()
                        updateStatusUI()
                    end
                    task.wait(0.03)
                    continue -- ASIL ALANA DÖNME, KENDİ ALANINDA SABİT BEKLE!
                end

            elseif Config.CoconutBeltEnabled and comboTriggered and not comboWasActive then
                -- 40. Coconut tüketildi ve combo tetiklendi: 0x doğana kadar tarladan ayrılma!
                local waitElapsed = tick() - comboTriggerTime
                if waitElapsed < 12.0 then
                    Stats.Status = string.format("🔥 Combo Tetiklendi! 🥥 0x Bekleniyor... (%.1fs)", 12.0 - waitElapsed)
                    hum:Move(Vector3.zero, false)
                    hrp.Velocity = Vector3.zero
                    task.wait(0.03)
                    if tick() - lastUiUpdate > 0.25 then
                        lastUiUpdate = tick()
                        updateStatusUI()
                    end
                    continue -- 0X ÇIKANA KADAR TARLADAN AYRILMA, TOKEN ARAMA!
                else
                    comboTriggered = false
                end

            elseif Config.CoconutBeltEnabled and comboWasActive then
                -- Coconut havada paslaşılıyor veya son coconut alındı.
                -- İki tarla arası uçuş ve pas payı için 7.5 saniye bekle:
                local timeSinceCombo = tick() - lastComboSeenTime

                if timeSinceCombo < 7.5 and maxComboSeen < 100 then
                    Stats.Status = string.format("🥥 Sonraki Pas / Combo Bekleniyor... (%.1fs)", 7.5 - timeSinceCombo)
                    hum:Move(Vector3.zero, false)
                    hrp.Velocity = Vector3.zero
                    task.wait(0.03)
                    if tick() - lastUiUpdate > 0.25 then
                        lastUiUpdate = tick()
                        updateStatusUI()
                    end
                    continue -- YENİ COMBO COCONUT GELİRSE YAKALAMAK İÇİN ALANDA SABİT KAL!
                else
                    -- 7.5 saniye geçti ve başka combo coconut gelmedi (FAIL oldu) VEYA 100x tamamlandı!
                    local finishReason = (maxComboSeen >= 100 and "🏆 100x Max Combo Tamamlandı!") or string.format("✅ Combo Bitti (%dx'de Fail Oldu)!", maxComboSeen)
                    Stats.Status = finishReason .. " Asıl Alana Dönülüyor..."
                    updateStatusUI()

                    comboWasActive = false
                    comboTriggered = false
                    comboTriggerTime = 0
                    highestStackInComboField = 0
                    maxComboSeen = 0

                    if Config.ReturnToMainField and Config.SelectedField then
                        local mainCenter = getFieldCenter(Config.SelectedField)
                        if mainCenter then
                            Stats.ComboState = "FLYING_TO_MAIN"
                            safeTweenTo(mainCenter, function()
                                Stats.ComboState = "NORMAL"
                                Stats.Status = "Asıl Alana Dönüldü, Farming Devam Ediyor"
                                hasCaughtZeroX = false
                            end)
                            continue
                        end
                    end
                    Stats.ComboState = "NORMAL"
                    hasCaughtZeroX = false
                end

            elseif Config.CoconutBeltEnabled and Stats.ComboState == "NORMAL" and currentBeltStack >= Config.CoconutThreshold then
                -- SADECE VE SADECE EKRANDAKİ SAYI EŞİĞE (Örn: 35) ULAŞTIĞINDA GEÇİŞ YAP!
                if Config.ComboField and Config.ComboField ~= Config.SelectedField then
                    local comboCenter = getFieldCenter(Config.ComboField)
                    local amInsideCombo = isInsideField(hrp.Position, Config.ComboField)

                    if not amInsideCombo and comboCenter then
                        Stats.ComboState = "FLYING_TO_COMBO"
                        highestStackInComboField = currentBeltStack
                        comboTriggered = false
                        comboWasActive = false
                        hasCaughtZeroX = false
                        maxComboSeen = 0
                        Stats.Status = string.format("Sayaç %d/40! %s Alanına Gidiliyor...", currentBeltStack, Config.ComboField)
                        updateStatusUI()

                        safeTweenTo(comboCenter, function()
                            Stats.ComboState = "IN_COMBO_FIELD"
                            Stats.Status = Config.ComboField .. " Alanında 40. Coconut Bekleniyor..."
                        end)
                        continue
                    else
                        Stats.ComboState = "IN_COMBO_FIELD"
                        highestStackInComboField = currentBeltStack
                    end
                end
            end

            -- ========================================================
            -- 2. STAR SHOWER (YERDEKİ KÜÇÜK YEŞİL HALKALAR - SIRA SIRA TWEEN & 3D SAYILAR)
            -- VE NORMAL COCONUT (BÜYÜK YEŞİL HALKALAR)
            -- ========================================================
            local targetStarDisk = nil
            local targetStarOrder = nil

            -- Düşen yıldızların yerdeki yeşil halkaları (WarningDisk)
            if Config.StarShowerTweenEnabled then
                targetStarDisk, targetStarOrder = getActiveStarShowerDisk(currentTargetField)
            end

            if targetStarDisk and targetStarDisk.Parent then
                local diskPos = targetStarDisk.Position
                -- Yerdeki halkanın zemin seviyesinde tam ortası
                local targetGroundPos = Vector3.new(diskPos.X, hrp.Position.Y, diskPos.Z)
                local dist = (hrp.Position - targetGroundPos).Magnitude
                local starNum = targetStarOrder or 1

                -- Kullanıcının isteği: "1. yıldız 1 yazsın 2.yıldız 2 yazsın ve tween sırasıyla gitsin"
                if Config.StarShowerMovementMode == "Anında Işınlanma (TP)" then
                    hrp.CFrame = CFrame.new(targetGroundPos)
                    hrp.Velocity = Vector3.zero
                    hum:Move(Vector3.zero, false)
                    Stats.Status = string.format("⭐ %d. Yıldız Halkasına Işınlanıldı! (Bekleniyor)", starNum)
                else
                    if dist > 2.0 then
                        Stats.Status = string.format("⭐ %d. Yıldız Halkasına Tween ile Süzülünüyor...", starNum)
                        tweenToGroundTarget(targetGroundPos, Config.StarShowerTweenSpeed or 120)
                    end
                    hum:Move(Vector3.zero, false)
                    hrp.Velocity = Vector3.zero
                    Stats.Status = string.format("⭐ %d. Yıldız Halkasında Bekleniyor / Alınıyor...", starNum)
                end

                if tick() - lastUiUpdate > 0.25 then
                    lastUiUpdate = tick()
                    updateStatusUI()
                end
                task.wait(0.03)
                continue -- Yıldızın yeşil halkasında kal, token toplamaya sapma!
            end

            -- Eğer star shower yoksa ve normal coconut tween'i açılmışsa:
            if not targetStarDisk and Config.FastTweenToNormalCoconut then
                local cocoDiskPos = getActiveCoconutDisk(currentTargetField)
                if cocoDiskPos then
                    local dist = (hrp.Position - cocoDiskPos).Magnitude
                    if dist > 2.0 then
                        Stats.Status = "🥥 Normal Coconut (Büyük Yeşil) Süzülünüyor..."
                        tweenToGroundTarget(cocoDiskPos, Config.NormalCoconutTweenSpeed or 100)
                    end

                    hum:Move(Vector3.zero, false)
                    hrp.Velocity = Vector3.zero
                    Stats.Status = "🥥 Normal Coconut Bekleniyor / Alınıyor..."

                    if tick() - lastUiUpdate > 0.25 then
                        lastUiUpdate = tick()
                        updateStatusUI()
                    end
                    task.wait(0.03)
                    continue -- Normal coconut alınıyor
                end
            end

            -- ========================================================
            -- 3. NORMAL VEYA COMBO ALANI TOKEN FARMING DÖNGÜSÜ
            -- ========================================================
            if Config.LockToField and not amInsideField and fieldCenter then
                if Config.AutoTweenToField then
                    safeTweenTo(fieldCenter)
                    continue
                else
                    Stats.Status = currentTargetField .. " Alanına Yürünüyor..."
                    local walkTarget = Vector3.new(fieldCenter.X, hrp.Position.Y, fieldCenter.Z)
                    hum:MoveTo(walkTarget)
                    continue
                end
            else
                -- Önbellek temizliği (3 saniyeden eski veya silinmiş tokenleri temizle)
                local curTick = tick()
                for tok, t in pairs(collectedTokensCache) do
                    if (curTick - t) > 3.0 or not tok.Parent then
                        collectedTokensCache[tok] = nil
                    end
                end

                local token, dist, tokenPriority, tokenLabel = getBestToken(currentTargetField)

                if token and token.Parent == Workspace:FindFirstChild("Collectibles") then
                    -- Token alma mesafesi: Karakter tokene yaklaştığında (<= 6 stud)
                    -- KESİNTİSİZ YÜRÜYÜŞ: Tokeni anında belleğe alıp DURMAKSIZIN sıradaki hedefe koşar!
                    if dist <= 6.0 then
                        collectedTokensCache[token] = curTick
                        Stats.CollectedCount = Stats.CollectedCount + 1
                        stuckTimer = 0

                        -- Anında sıradaki tokeni sorgula (duraksamadan devam et)
                        local nextTok, nextDist, nextPri, nextLabel = getBestToken(currentTargetField)
                        if nextTok and nextTok.Parent == Workspace:FindFirstChild("Collectibles") then
                            Stats.CurrentTarget = nextTok
                            local nextWalkTarget = Vector3.new(nextTok.Position.X, hrp.Position.Y, nextTok.Position.Z)
                            hum:MoveTo(nextWalkTarget)
                            if nextPri == "LINK" then
                                Stats.Status = string.format("🔗 Token Link (1. Öncelik) Alınıyor! (%.1fm)", nextDist)
                            elseif nextPri == "BOOST" then
                                local icon = (nextLabel == "Red Boost" and "🔴" or "🔵")
                                Stats.Status = string.format("%s %s (2. Öncelik) Alınıyor! (%.1fm)", icon, nextLabel, nextDist)
                            else
                                Stats.Status = string.format("⚡ Sıradaki Token'a Koşuluyor (%.1fm)", nextDist)
                            end
                        elseif fieldCenter then
                            -- Başka token kalmadıysa tarlada çiçekler üzerinde gezinmeye kesintisiz devam et
                            Stats.CurrentTarget = nil
                            local flatRoamDist = currentRoamTarget and (Vector2.new(hrp.Position.X, hrp.Position.Z) - Vector2.new(currentRoamTarget.X, currentRoamTarget.Z)).Magnitude or math.huge
                            if not currentRoamTarget or flatRoamDist < 4 or (curTick - lastRoamChange) > 2.5 then
                                local angle = math.random() * math.pi * 2
                                local r = math.random(6, Config.CenterRoamRadius or 22)
                                currentRoamTarget = Vector3.new(fieldCenter.X + math.cos(angle) * r, hrp.Position.Y, fieldCenter.Z + math.sin(angle) * r)
                                lastRoamChange = curTick
                            end
                            Stats.Status = "🌸 Tarlada Çiçekler Üzerinde Geziniyor..."
                            hum:MoveTo(currentRoamTarget)
                        end
                    else
                        Stats.CurrentTarget = token
                        if tokenPriority == "LINK" then
                            Stats.Status = string.format("🔗 Token Link (1. Öncelik) Alınıyor! (%.1fm)", dist)
                        elseif tokenPriority == "BOOST" then
                            local icon = (tokenLabel == "Red Boost" and "🔴" or "🔵")
                            Stats.Status = string.format("%s %s (2. Öncelik) Alınıyor! (%.1fm)", icon, tokenLabel, dist)
                        else
                            Stats.Status = string.format("⚡ Token'a Gidiliyor (%.1fm)", dist)
                        end
                        local walkTarget = Vector3.new(token.Position.X, hrp.Position.Y, token.Position.Z)
                        hum:MoveTo(walkTarget)
                    end

                    -- Akıllı Takılma Kontrolü (Sadece takılma önleyici zıplama açıksa ve yürümeye çalışırken takılı kaldıysa)
                    if Config.AutoJump and hum.MoveDirection.Magnitude > 0.4 then
                        if lastPos then
                            local movedDist = (hrp.Position - lastPos).Magnitude
                            if movedDist < 0.3 then
                                stuckTimer = stuckTimer + 0.025
                                if stuckTimer >= 2.5 then
                                    hum.Jump = true
                                    stuckTimer = 0
                                end
                            else
                                stuckTimer = 0
                            end
                        end
                    else
                        stuckTimer = 0
                    end
                    lastPos = hrp.Position
                else
                    -- ALANDA TOPLANACAK TOKEN YOKSA:
                    -- MERKEZ ETRAFINDA ÇİÇEKLERDE SÜREKLİ DEVRİYE GEZ (ROAM)
                    -- Y Koordinatı kesinlikle karakterin zemin yüksekliğinde (hrp.Position.Y) tutulur
                    Stats.CurrentTarget = nil
                    stuckTimer = 0

                    if Config.RoamWhenNoTokens and fieldCenter then
                        local now = tick()
                        local flatRoamDist = currentRoamTarget and (Vector2.new(hrp.Position.X, hrp.Position.Z) - Vector2.new(currentRoamTarget.X, currentRoamTarget.Z)).Magnitude or math.huge
                        if not currentRoamTarget or flatRoamDist < 4 or (now - lastRoamChange) > 2.5 then
                            local angle = math.random() * math.pi * 2
                            local r = math.random(6, Config.CenterRoamRadius or 22)
                            currentRoamTarget = Vector3.new(fieldCenter.X + math.cos(angle) * r, hrp.Position.Y, fieldCenter.Z + math.sin(angle) * r)
                            lastRoamChange = now
                        end

                        Stats.Status = "🌸 Tarlada Çiçekler Üzerinde Geziniyor..."
                        hum:MoveTo(currentRoamTarget)

                        if Config.AutoJump and hum.MoveDirection.Magnitude > 0.4 then
                            if lastPos then
                                local movedDist = (hrp.Position - lastPos).Magnitude
                                if movedDist < 0.3 then
                                    stuckTimer = stuckTimer + 0.025
                                    if stuckTimer >= 2.5 then
                                        hum.Jump = true
                                        stuckTimer = 0
                                    end
                                else
                                    stuckTimer = 0
                                end
                            end
                        end
                        lastPos = hrp.Position
                    else
                        if fieldCenter then
                            local flatDistToCenter = (Vector2.new(hrp.Position.X, hrp.Position.Z) - Vector2.new(fieldCenter.X, fieldCenter.Z)).Magnitude
                            if flatDistToCenter > 15 then
                                Stats.Status = "Tarla Merkezine Dönülüyor..."
                                local walkTarget = Vector3.new(fieldCenter.X, hrp.Position.Y, fieldCenter.Z)
                                hum:MoveTo(walkTarget)
                            else
                                Stats.Status = "Yeni Tokenler Bekleniyor..."
                                hum:Move(Vector3.zero, false)
                            end
                        else
                            Stats.Status = "Token Bekleniyor..."
                            hum:Move(Vector3.zero, false)
                        end
                    end
                end
            end
        end

        -- Belirli aralıklarla UI güncellemesi
        if tick() - lastUiUpdate > 0.35 then
            lastUiUpdate = tick()
            updateStatusUI()
        end
    end
end)

-- Cleanup function
getgenv().AutoFarmTokenCleanup = function()
    running = false
    Config.Enabled = false
    isConverting = false
    hasTriggeredConvert = false
    Stats.Converting = false
    Stats.ConvertState = "IDLE"
    stopTween()
    local hum, _ = getCharacterComponents()
    if hum then
        hum:Move(Vector3.zero, false)
    end
    for _, data in pairs(starShowerDisks) do
        if data.tag then
            pcall(function() data.tag:Destroy() end)
        end
    end
    table.clear(starShowerDisks)
    pcall(function()
        Window:Destroy()
    end)
end

InfoTab:Button({
    Title = "Scripti Kapat",
    Callback = function()
        getgenv().AutoFarmTokenCleanup()
    end,
})

