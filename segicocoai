-- Helper: Get Field Bounds
local function getFieldBounds(fieldName)
    if not FlowerZonesFolder or not fieldName then return nil, nil end
    local zone = FlowerZonesFolder:FindFirstChild(fieldName)
    if not zone or not zone:IsA("BasePart") then return nil, nil end
    return zone.CFrame, zone.Size
end

-- Helper: Get Field Center
local function getFieldCenter(fieldName)
    if not FlowerZonesFolder or not fieldName then return nil end
    local zone = FlowerZonesFolder:FindFirstChild(fieldName)
    if not zone or not zone:IsA("BasePart") then return nil end
    return zone.Position + Vector3.new(0, 3.5, 0)
end

-- Helper: Check if a Position is Inside Field
local function isInsideField(pos, fieldName)
    local cf, size = getFieldBounds(fieldName)
    if not cf or not size then return false end
    local localPos = cf:PointToObjectSpace(pos)
    local half = size / 2
    local margin = 6.0
    return math.abs(localPos.X) <= (half.X + margin) and math.abs(localPos.Z) <= (half.Z + margin)
end

-- Helper: Pollen / Bag Capacity Checker
local function getPollenInfo()
    local pollen = 0
    local maxPollen = 0

    local coreStats = LocalPlayer:FindFirstChild("CoreStats")
    if coreStats then
        local pVal = coreStats:FindFirstChild("Pollen")
        local capVal = coreStats:FindFirstChild("Capacity")
        if pVal and pVal:IsA("ValueBase") then pollen = tonumber(pVal.Value) or 0 end
        if capVal and capVal:IsA("ValueBase") then maxPollen = tonumber(capVal.Value) or 0 end
    end

    if maxPollen <= 0 then
        local pg = LocalPlayer:FindFirstChild("PlayerGui")
        if pg then
            for _, obj in ipairs(pg:GetDescendants()) do
                if obj:IsA("TextLabel") and obj.Text then
                    local p, m = obj.Text:match("(%d[%d%,]*)%s*/%s*(%d[%d%,]*)")
                    if p and m then
                        local cleanP = tonumber((p:gsub(",", "")))
                        local cleanM = tonumber((m:gsub(",", "")))
                        if cleanP and cleanM and cleanM > 1000 then
                            pollen = cleanP
                            maxPollen = cleanM
                            break
                        end
                    end
                end
            end
        end
    end

    local percent = 0
    if maxPollen > 0 then
        percent = math.clamp((pollen / maxPollen) * 100, 0, 100)
    end

    return pollen, maxPollen, percent
end

-- Helper: Find Player's Own Hive Pad Position & Hive Object
local function getPlayerHive()
    -- 1. Doğrudan Workspace.HivePlatforms üzerinden oyuncunun kovan platformunu (yerdeki daireyi) bul
    local hivePlatforms = Workspace:FindFirstChild("HivePlatforms")
    if hivePlatforms then
        for _, platModel in ipairs(hivePlatforms:GetChildren()) do
            local playerRef = platModel:FindFirstChild("PlayerRef")
            if playerRef and playerRef:IsA("ValueBase") and playerRef.Value == LocalPlayer then
                local platPart = platModel:FindFirstChild("Platform") or platModel:FindFirstChild("Circle") or platModel:FindFirstChildWhichIsA("BasePart")
                local hiveObj = (platModel:FindFirstChild("Hive") and platModel.Hive.Value)
                    or (platModel:FindFirstChild("Honeycomb") and platModel.Honeycomb.Value)
                if platPart then
                    return platPart.Position + Vector3.new(0, 3.2, 0), hiveObj
                end
            end
        end
    end

    -- 2. Workspace.Honeycombs üzerinden oyuncunun kovanını ve CFrameValue olan SpawnPos'u bul
    local honeycombs = Workspace:FindFirstChild("Honeycombs")
    if honeycombs then
        for _, hive in ipairs(honeycombs:GetChildren()) do
            local owner = hive:FindFirstChild("Owner")
            if owner and owner:IsA("ValueBase") and owner.Value == LocalPlayer then
                local spawnPos = hive:FindFirstChild("SpawnPos")
                if spawnPos then
                    if spawnPos:IsA("CFrameValue") then
                        return spawnPos.Value.Position + Vector3.new(0, 1.2, 0), hive
                    elseif spawnPos:IsA("Vector3Value") then
                        return spawnPos.Value + Vector3.new(0, 1.2, 0), hive
                    elseif spawnPos:IsA("BasePart") then
                        return spawnPos.Position + Vector3.new(0, 3.2, 0), hive
                    end
                end
                local platVal = hive:FindFirstChild("Platform")
                if platVal and platVal:IsA("ObjectValue") and platVal.Value then
                    local pModel = platVal.Value
                    local pPart = (pModel:IsA("BasePart") and pModel)
                        or pModel:FindFirstChild("Platform")
                        or pModel:FindFirstChild("Circle")
                        or pModel:FindFirstChildWhichIsA("BasePart")
                    if pPart then
                        return pPart.Position + Vector3.new(0, 3.2, 0), hive
                    end
                end
            end
        end
    end

    return nil, nil
end

