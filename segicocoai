-- Toplanan tokenleri anlık belleğe alarak karakterin duraksamadan sonraki tokene kesintisiz koşmasını sağlar
local collectedTokensCache = {}

-- Best Token Finder for current active field (1. Öncelik: Token Link, 2. Öncelik: Red/Blue Boost, 3. Normal)
local function getBestToken(targetField, maxRadius)
    local hum, hrp = getCharacterComponents()
    if not hum or not hrp then return nil, 0, nil, nil end

    local collectibles = Workspace:FindFirstChild("Collectibles")
    if not collectibles then return nil, 0, nil, nil end

    -- 1. Öncelik: Token Link / Conversion Link
    local bestTokenLink = nil
    local shortestTokenLinkDist = math.huge

    -- 2. Öncelik: Red Boost / Blue Boost
    local bestBoost = nil
    local shortestBoostDist = math.huge
    local boostName = ""

    -- 3. Öncelik: Normal tokenler
    local bestNormalToken = nil
    local shortestNormalDist = math.huge

    local nearbyCount = 0
    local now = tick()

    for _, c in ipairs(collectibles:GetChildren()) do
        if c:IsA("BasePart") then
            -- Eğer token son 1.5 saniye içinde toplandıysa yoksay
            if not (collectedTokensCache[c] and (now - collectedTokensCache[c]) < 1.5) then
                local frontDecal = c:FindFirstChild("FrontDecal")
                local isFaded = c.Transparency > 0.85 or (frontDecal and frontDecal.Transparency > 0.85)

                if not isFaded then
                    local inField = true
                    if Config.LockToField then
                        inField = isInsideField(c.Position, targetField)
                    end

                    if inField then
                        nearbyCount = nearbyCount + 1
                        local distToPlayer = (c.Position - hrp.Position).Magnitude
                        if not maxRadius or distToPlayer <= maxRadius then
                            local tex = frontDecal and frontDecal.Texture and tostring(frontDecal.Texture)

                            -- 1. ÖNCELİK: Token Link veya Conversion Link
                            local isTokenLink = false
                            if tex and (tex:find("1629547638") or tex:find("1874564120")) then
                                isTokenLink = true
                            end

                            -- 2. ÖNCELİK: Red Boost veya Blue Boost
                            local currentBoostType = nil
                            if tex then
                                if tex:find("1442859163") then
                                    currentBoostType = "Red Boost"
                                elseif tex:find("1442863423") then
                                    currentBoostType = "Blue Boost"
                                end
                            end

                            if isTokenLink then
                                if distToPlayer < shortestTokenLinkDist then
                                    shortestTokenLinkDist = distToPlayer
                                    bestTokenLink = c
                                end
                            elseif currentBoostType then
                                if distToPlayer < shortestBoostDist then
                                    shortestBoostDist = distToPlayer
                                    bestBoost = c
                                    boostName = currentBoostType
                                end
                            else
                                if distToPlayer < shortestNormalDist then
                                    shortestNormalDist = distToPlayer
                                    bestNormalToken = c
                                end
                            end
                        end
                    end
                end
            end
        end
    end

    Stats.NearbyTokens = nearbyCount

    -- 1. ÖNCELİK: TOKEN LINK
    if bestTokenLink then
        return bestTokenLink, shortestTokenLinkDist, "LINK", "Token Link"
    -- 2. ÖNCELİK: RED / BLUE BOOST
    elseif bestBoost then
        return bestBoost, shortestBoostDist, "BOOST", boostName
    -- 3. ÖNCELİK: NORMAL TOKENLER
    elseif bestNormalToken then
        return bestNormalToken, shortestNormalDist, "NORMAL", "Token"
    else
        return nil, 0, nil, nil
    end
end

-- Main Automation Loop
local running = true
local lastPos = nil
local stuckTimer = 0
local lastUiUpdate = 0
local currentRoamTarget = nil
local lastRoamChange = 0
local isConverting = false
local hasTriggeredConvert = false
local lastConvertTriggerTime = 0

task.spawn(function()
    while running do
        task.wait(0.02)

        local hum, hrp = getCharacterComponents()

        -- Ragdoll Önleyici & Özel Yürüme Hızı (Oto Farm kapalı olsa bile her zaman çalışır!)
        if hum and hum.Health > 0 then
            applyAntiRagdollStates(hum)
            if Config.CustomSpeedEnabled and Config.CustomSpeed then
                hum.WalkSpeed = Config.CustomSpeed
            end
        end

        -- Tween sırasında token toplamayı ve yürümeyi tamamen durdur
        if Stats.IsTweening then
            if hum then
                hum:Move(Vector3.zero, false)
            end
            task.wait(0.02)
            continue
        end

        if Config.Enabled and hum and hrp and hum.Health > 0 then
            -- DOĞRUDAN EKRANDAKİ BUFF'IN ÜZERİNDEKİ SAYACI OKU (Örn: 20, 35, 40)
            local currentBeltStack = getCoconutBeltStackFromGui()
            Stats.CoconutCount = currentBeltStack

            -- Combo tarlası modunda mıyız? (35+ olup Combo tarlasına geçtiysek, combo bitene kadar hedef tarla ComboField'dır!)
            local inComboFieldMode = (Stats.ComboState == "IN_COMBO_FIELD" or Stats.ComboState == "WAITING_FOR_0X" or Stats.ComboState == "FLYING_TO_COMBO")
            local currentTargetField = (inComboFieldMode and Config.ComboField) or Config.SelectedField
            if currentTargetField == "Mevcut Konum (Otomatik)" then
                currentTargetField = getCurrentField() or "Pepper Patch"
            end

            -- Combo tarlası içindeyken sayaç takibi:
            if inComboFieldMode then
                if currentBeltStack > highestStackInComboField then
                    highestStackInComboField = currentBeltStack
                end

                -- Eğer 35+ stack görüldükten sonra sayaç 0 olduysa (40. hindistan cevizi alınıp sıfırlandıysa) veya 40'a ulaştıysa COMBO TETİKLENMİŞTİR:
                if (highestStackInComboField >= Config.CoconutThreshold and currentBeltStack == 0 and not comboWasActive) or currentBeltStack >= 40 then
                    if not comboTriggered then
                        comboTriggered = true
                        comboTriggerTime = tick()
                        Stats.ComboState = "WAITING_FOR_0X"
                    end
                end
            end

            -- ========================================================
            -- 0. OTO BAL YAPMA (AUTO CONVERT AT HIVE)
            -- (Combo aktifken veya combo tarlasında 40. coconut beklenirken bal yapmaya gitmez, comboyu bozmaz!)
            -- ========================================================
            local pollen, maxPollen, pollenPercent = getPollenInfo()

            if Config.AutoConvertEnabled and not isConverting and not inComboFieldMode and not comboWasActive and not comboTriggered and pollenPercent >= (Config.ConvertThreshold or 100) and maxPollen > 0 then
                local hivePos, _ = getPlayerHive()
                if hivePos then
                    isConverting = true
                    hasTriggeredConvert = false
                    lastConvertTriggerTime = 0
                    Stats.Converting = true
                    Stats.ConvertState = "GOING_TO_HIVE"
                    Stats.Status = string.format("🍯 Çanta %%%d Doldu! Kovana Uçuluyor...", math.floor(pollenPercent))
                    updateStatusUI()

                    safeTweenTo(hivePos, function()
                        Stats.ConvertState = "MAKING_HONEY"
                        Stats.Status = "🍯 Kovana Varıldı, Bal Yapılıyor..."
                        updateStatusUI()
                    end)
                    continue
                end
            end

            if isConverting then
                local hivePos, hiveObj = getPlayerHive()
                if hivePos then
                    local distToHive = (hrp.Position - hivePos).Magnitude
                    if distToHive > 8.5 then
                        if not Stats.IsTweening then
                            Stats.ConvertState = "GOING_TO_HIVE"
                            Stats.Status = "🍯 Kovan Platformuna Uçuluyor..."
                            updateStatusUI()
                            safeTweenTo(hivePos, function()
                                Stats.ConvertState = "MAKING_HONEY"
                                Stats.Status = "🍯 Kovana Varıldı, Bal Yapılıyor..."
                                updateStatusUI()
                            end)
                        end
                        task.wait(0.05)
                        continue
                    end
                end

                hum:Move(Vector3.zero, false)
                hrp.Velocity = Vector3.zero

                local phaseObj = hiveObj and hiveObj:FindFirstChild("Phase")
                local isHiveIdle = (not phaseObj) or (phaseObj.Value == "Idle")

                if pollen > 0.5 and isHiveIdle and (not hasTriggeredConvert or (tick() - lastConvertTriggerTime) > 2.2) then
                    hasTriggeredConvert = true
                    lastConvertTriggerTime = tick()
                    task.wait(0.25)
                    pcall(function()
                        local evModule = ReplicatedStorage:FindFirstChild("Events")
                        if evModule and evModule:IsA("ModuleScript") then
                            require(evModule).ClientCall("PlayerHiveCommand", "ToggleHoneyMaking")
                        else
                            local toggleHoney = evModule and evModule:FindFirstChild("PlayerHiveCommand")
                            if toggleHoney and toggleHoney:IsA("RemoteEvent") then
                                toggleHoney:FireServer("ToggleHoneyMaking")
                            elseif toggleHoney and toggleHoney:IsA("RemoteFunction") then
                                toggleHoney:InvokeServer("ToggleHoneyMaking")
                            end
                        end
                    end)
                    Stats.Status = "🍯 Bal Yapma Başlatıldı (Boşalması Bekleniyor)..."
                    updateStatusUI()
                end

                if pollen <= 0.5 or pollenPercent <= 0.5 then
                    Stats.Status = "✅ Bal Yapma Tamamlandı! Tarlaya Dönülüyor..."
                    Stats.ConvertState = "RETURNING"
                    updateStatusUI()

                    isConverting = false
                    hasTriggeredConvert = false
                    lastConvertTriggerTime = 0
                    Stats.Converting = false
                    Stats.ConvertState = "IDLE"

                    if currentTargetField and currentTargetField ~= "Mevcut Konum (Otomatik)" then
                        local fieldCenter = getFieldCenter(currentTargetField)
                        if fieldCenter then
                            safeTweenTo(fieldCenter, function()
                                Stats.Status = "Tarlaya Dönüldü, Farming Başlatıldı"
                                updateStatusUI()
                            end)
                            continue
                        end
                    end
                else
                    Stats.Status = string.format("🍯 Bal Yapılıyor... Kalan Çanta: %%%d", math.floor(pollenPercent))
                    if tick() - lastUiUpdate > 0.3 then
                        lastUiUpdate = tick()
                        updateStatusUI()
                    end
                    task.wait(0.05)
                    continue
                end
            end

            -- ========================================================
            -- 1. COCONUT BELT & MULTI-PLAYER COMBO JUGGLING
            -- ========================================================
            local ourCombo, otherCombo, anyComboExists, maxPoints = getComboCoconutsInfo(currentTargetField)

            if anyComboExists and maxPoints > maxComboSeen then
                maxComboSeen = maxPoints
            end

            if Config.CoconutBeltEnabled and anyComboExists then
                comboWasActive = true
                comboTriggered = false
                lastComboSeenTime = tick()

                if ourCombo then
                    if ourCombo.Points == 0 then
                        hasCaughtZeroX = true
                        Stats.Status = "⚡ 🥥 0x Bizim Alanda - Süzülünüyor & Bekleniyor!"
                    else
                        Stats.Status = string.format("⚡ 🥥 %s Bizim Alanda (%s) - Süzülünüyor!", ourCombo.Text, currentTargetField)
                    end

                    if Config.ComboMovementMode == "Anında Işınlanma (TP)" then
                        hrp.CFrame = CFrame.new(ourCombo.Position.X, hrp.Position.Y, ourCombo.Position.Z)
                        hrp.Velocity = Vector3.zero
                        hum:Move(Vector3.zero, false)
                    else
                        local comboSpeed = Config.ComboTweenSpeed or Config.TweenSpeed or 95
                        tweenToGroundTarget(ourCombo.Position, comboSpeed)
                        hum:Move(Vector3.zero, false)
                    end

                    if tick() - lastUiUpdate > 0.25 then
                        lastUiUpdate = tick()
                        updateStatusUI()
                    end
                    task.wait(0.03)
                    continue

                elseif otherCombo then
                    hum:Move(Vector3.zero, false)
                    hrp.Velocity = Vector3.zero
                    Stats.Status = string.format("🥥 Coconut %s Alanında (%s) | Bizim Tarlada Sıra Bekleniyor...", otherCombo.Field or "Başka Alanda", otherCombo.Text)

                    if tick() - lastUiUpdate > 0.25 then
                        lastUiUpdate = tick()
                        updateStatusUI()
                    end
                    task.wait(0.03)
                    continue
                end

            elseif Config.CoconutBeltEnabled and comboTriggered and not comboWasActive then
                local waitElapsed = tick() - comboTriggerTime
                if waitElapsed < 12.0 then
                    Stats.Status = string.format("🔥 Combo Tetiklendi! 🥥 0x Bekleniyor... (%.1fs)", 12.0 - waitElapsed)
                    hum:Move(Vector3.zero, false)
                    hrp.Velocity = Vector3.zero
                    task.wait(0.03)
                    if tick() - lastUiUpdate > 0.25 then
                        lastUiUpdate = tick()
                        updateStatusUI()
                    end
                    continue
                else
                    comboTriggered = false
                end

            elseif Config.CoconutBeltEnabled and comboWasActive then
                local timeSinceCombo = tick() - lastComboSeenTime

                if timeSinceCombo < 7.5 and maxComboSeen < 100 then
                    Stats.Status = string.format("🥥 Sonraki Pas / Combo Bekleniyor... (%.1fs)", 7.5 - timeSinceCombo)
                    hum:Move(Vector3.zero, false)
                    hrp.Velocity = Vector3.zero
                    task.wait(0.03)
                    if tick() - lastUiUpdate > 0.25 then
                        lastUiUpdate = tick()
                        updateStatusUI()
                    end
                    continue
                else
                    local finishReason = (maxComboSeen >= 100 and "🏆 100x Max Combo Tamamlandı!") or string.format("✅ Combo Bitti (%dx'de Fail Oldu)!", maxComboSeen)
                    Stats.Status = finishReason .. " Asıl Alana Dönülüyor..."
                    updateStatusUI()

                    comboWasActive = false
                    comboTriggered = false
                    comboTriggerTime = 0
                    highestStackInComboField = 0
                    maxComboSeen = 0

                    if Config.ReturnToMainField and Config.SelectedField then
                        local mainCenter = getFieldCenter(Config.SelectedField)
                        if mainCenter then
                            Stats.ComboState = "FLYING_TO_MAIN"
                            safeTweenTo(mainCenter, function()
                                Stats.ComboState = "NORMAL"
                                Stats.Status = "Asıl Alana Dönüldü, Farming Devam Ediyor"
                                hasCaughtZeroX = false
                            end)
                            continue
                        end
                    end
                    Stats.ComboState = "NORMAL"
                    hasCaughtZeroX = false
                end

            elseif Config.CoconutBeltEnabled and Stats.ComboState == "NORMAL" and currentBeltStack >= Config.CoconutThreshold then
                if Config.ComboField and Config.ComboField ~= Config.SelectedField then
                    local comboCenter = getFieldCenter(Config.ComboField)
                    local amInsideCombo = isInsideField(hrp.Position, Config.ComboField)

                    if not amInsideCombo and comboCenter then
                        Stats.ComboState = "FLYING_TO_COMBO"
                        highestStackInComboField = currentBeltStack
                        comboTriggered = false
                        comboWasActive = false
                        hasCaughtZeroX = false
                        maxComboSeen = 0
                        Stats.Status = string.format("Sayaç %d/40! %s Alanına Gidiliyor...", currentBeltStack, Config.ComboField)
                        updateStatusUI()

                        safeTweenTo(comboCenter, function()
                            Stats.ComboState = "IN_COMBO_FIELD"
                            Stats.Status = Config.ComboField .. " Alanında 40. Coconut Bekleniyor..."
                        end)
                        continue
                    else
                        Stats.ComboState = "IN_COMBO_FIELD"
                        highestStackInComboField = currentBeltStack
                    end
                end
            end

            -- ========================================================
            -- 2. STAR SHOWER (YERDEKİ KÜÇÜK YEŞİL HALKALAR - SIRA SIRA, AKILLI YETİŞME & TAM MERKEZ)
            -- ========================================================
            local targetStarDisk = nil
            local targetStarOrder = nil

            if Config.StarShowerTweenEnabled then
                targetStarDisk, targetStarOrder = getActiveStarShowerDisk(currentTargetField)
            end

            if targetStarDisk and targetStarDisk.Parent then
                local diskPos = targetStarDisk.Position
                -- Yerdeki halkanın tam ortası ve karakterin ayak basma seviyesi (+3.1 stud)
                local targetExactPos = Vector3.new(diskPos.X, diskPos.Y + 3.1, diskPos.Z)
                local dist = (hrp.Position - targetExactPos).Magnitude
                local starNum = targetStarOrder or 1

                if Config.StarShowerMovementMode == "Anında Işınlanma (TP)" then
                    local currentLook = hrp.CFrame.LookVector
                    local flatLook = Vector3.new(currentLook.X, 0, currentLook.Z)
                    if flatLook.Magnitude < 0.05 then flatLook = Vector3.new(0, 0, -1) else flatLook = flatLook.Unit end
                    hrp.CFrame = CFrame.lookAt(targetExactPos, targetExactPos + flatLook)
                    hrp.Velocity = Vector3.zero
                    hum:Move(Vector3.zero, false)
                    Stats.Status = string.format("⭐ %d. Yıldız Halkasına Işınlanıldı! (Bekleniyor)", starNum)
                elseif Config.StarShowerMovementMode == "Hızlı Koşma (WalkSpeed)" then
                    hum.WalkSpeed = math.max(160, Config.StarShowerTweenSpeed or 160)
                    hum:MoveTo(targetExactPos)
                    Stats.Status = string.format("⭐ %d. Yıldız Halkasına Koşuluyor...", starNum)
                else -- "Akıllı Sıralı Tween (Slider Hızı)"
                    local flatDist = Vector2.new(hrp.Position.X - diskPos.X, hrp.Position.Z - diskPos.Z).Magnitude
                    if flatDist > 2.0 then
                        Stats.Status = string.format("⭐ %d. Yıldız Halkasına Süzülünüyor...", starNum)
                        tweenToStarShowerTarget(targetStarDisk, targetExactPos, Config.StarShowerTweenSpeed or 140)
                    else
                        -- Zaten halkanın içindeyiz: Merkezde sabit dur ve yıldızın düşmesini bekle
                        if flatDist > 1.2 then
                            local currentLook = hrp.CFrame.LookVector
                            local flatLook = Vector3.new(currentLook.X, 0, currentLook.Z)
                            if flatLook.Magnitude < 0.05 then flatLook = Vector3.new(0, 0, -1) else flatLook = flatLook.Unit end
                            hrp.CFrame = CFrame.lookAt(targetExactPos, targetExactPos + flatLook)
                        end
                        hrp.Velocity = Vector3.zero
                        hum:Move(Vector3.zero, false)
                        Stats.Status = string.format("⭐ %d. Yıldız Halkasında Bekleniyor / Alınıyor...", starNum)
                    end
                end

                if tick() - lastUiUpdate > 0.25 then
                    lastUiUpdate = tick()
                    updateStatusUI()
                end
                task.wait(0.02)
                continue -- Yıldızın yeşil halkasında kal, token toplamaya sapma!
            end

            -- Eğer star shower yoksa ve normal coconut tween'i açılmışsa:
            if not targetStarDisk and Config.FastTweenToNormalCoconut then
                local cocoDiskPos = getActiveCoconutDisk(currentTargetField)
                if cocoDiskPos then
                    local dist = (hrp.Position - cocoDiskPos).Magnitude
                    if dist > 2.0 then
                        Stats.Status = "🥥 Normal Coconut (Büyük Yeşil) Süzülünüyor..."
                        tweenToGroundTarget(cocoDiskPos, Config.NormalCoconutTweenSpeed or 100)
                    end

                    hum:Move(Vector3.zero, false)
                    hrp.Velocity = Vector3.zero
                    Stats.Status = "🥥 Normal Coconut Bekleniyor / Alınıyor..."

                    if tick() - lastUiUpdate > 0.25 then
                        lastUiUpdate = tick()
                        updateStatusUI()
                    end
                    task.wait(0.03)
                    continue
                end
            end

            -- ========================================================
            -- 3. ALAN İÇİ GÜVENLİK & OTOMATİK TWEEN
            -- ========================================================
            if Config.LockToField and currentTargetField and currentTargetField ~= "Mevcut Konum (Otomatik)" then
                local inside = isInsideField(hrp.Position, currentTargetField)
                if not inside then
                    if Config.AutoTweenToField then
                        local center = getFieldCenter(currentTargetField)
                        if center then
                            Stats.Status = currentTargetField .. " Alanına Uçuluyor..."
                            updateStatusUI()
                            safeTweenTo(center, function()
                                Stats.Status = currentTargetField .. " Alanına Varıldı"
                                updateStatusUI()
                            end)
                            continue
                        end
                    end
                end
            end

            -- Özel Hız Ayarlaması
            if Config.CustomSpeedEnabled and Config.CustomSpeed then
                hum.WalkSpeed = Config.CustomSpeed
            end

            -- ========================================================
            -- 4. AKILLI ÖNCELİKLİ TOKEN TOPLAMA
            -- ========================================================
            local bestToken, shortestDist, tokenCategory, tokenDesc = getBestToken(currentTargetField, (Config.SelectedField == "Mevcut Konum (Otomatik)" and Config.MaxDistance) or nil)

            if bestToken and bestToken.Parent then
                local targetPos = bestToken.Position
                local currentDist = (hrp.Position - targetPos).Magnitude

                -- Token toplandığında anlık belleğe al ve duraksamadan sonrakine koş
                if currentDist <= 3.8 then
                    collectedTokensCache[bestToken] = tick()
                    Stats.TotalCollected = Stats.TotalCollected + 1
                    Stats.CurrentTarget = nil

                    local nextToken, _, _, nextDesc = getBestToken(currentTargetField, (Config.SelectedField == "Mevcut Konum (Otomatik)" and Config.MaxDistance) or nil)
                    if nextToken and nextToken.Parent then
                        local nextPos = nextToken.Position
                        local walkTarget = Vector3.new(nextPos.X, hrp.Position.Y, nextPos.Z)
                        hum:MoveTo(walkTarget)
                        Stats.Status = "⚡ Seri Toplama: " .. tostring(nextDesc or "Token")
                    else
                        hum:Move(Vector3.zero, false)
                    end
                else
                    Stats.CurrentTarget = bestToken
                    local walkTarget = Vector3.new(targetPos.X, hrp.Position.Y, targetPos.Z)
                    hum:MoveTo(walkTarget)

                    if tokenCategory == "LINK" then
                        Stats.Status = "⚡ 1. ÖNCELİK: " .. tokenDesc .. " Toplanıyor (Vakum)!"
                    elseif tokenCategory == "BOOST" then
                        Stats.Status = "🚀 2. ÖNCELİK: " .. tokenDesc .. " Toplanıyor!"
                    else
                        Stats.Status = "Token Toplanıyor (" .. string.format("%.1f", currentDist) .. "m)"
                    end
                end

                -- Takılma kontrolü
                if lastPos and (hrp.Position - lastPos).Magnitude < 0.3 then
                    stuckTimer = stuckTimer + 1
                    if stuckTimer >= 25 then
                        if Config.AutoJump then
                            hum.Jump = true
                        end
                        stuckTimer = 0
                    end
                else
                    stuckTimer = 0
                end
                lastPos = hrp.Position

            else
                -- ========================================================
                -- 5. TARLADA TOKEN YOKSA: MERKEZDE DEVRİYE (ROAM / WANDER)
                -- ========================================================
                Stats.CurrentTarget = nil

                if Config.RoamWhenNoTokens and currentTargetField and currentTargetField ~= "Mevcut Konum (Otomatik)" then
                    local fieldCenter = getFieldCenter(currentTargetField)
                    if fieldCenter then
                        local now = tick()
                        local distToRoam = currentRoamTarget and (Vector2.new(hrp.Position.X, hrp.Position.Z) - Vector2.new(currentRoamTarget.X, currentRoamTarget.Z)).Magnitude or math.huge

                        if not currentRoamTarget or distToRoam < 4 or (now - lastRoamChange) > 4.5 then
                            lastRoamChange = now
                            local angle = math.random() * math.pi * 2
                            local radius = math.random(6, Config.CenterRoamRadius or 22)
                            local offsetX = math.cos(angle) * radius
                            local offsetZ = math.sin(angle) * radius

                            currentRoamTarget = Vector3.new(fieldCenter.X + offsetX, hrp.Position.Y, fieldCenter.Z + offsetZ)
                        end

                        Stats.Status = "🌾 Devriye Geziliyor (Yeni Token Üretiliyor)..."
                        hum:MoveTo(currentRoamTarget)
                    else
                        Stats.Status = "Token Bekleniyor..."
                        hum:Move(Vector3.zero, false)
                    end
                else
                    if Config.SelectedField == "Mevcut Konum (Otomatik)" then
                        Stats.Status = "Yakında Token Bekleniyor..."
                        hum:Move(Vector3.zero, false)
                    else
                        local fieldCenter = getFieldCenter(currentTargetField)
                        if fieldCenter then
                            local flatDistToCenter = (Vector2.new(hrp.Position.X, hrp.Position.Z) - Vector2.new(fieldCenter.X, fieldCenter.Z)).Magnitude
                            if flatDistToCenter > 15 then
                                Stats.Status = "Tarla Merkezine Dönülüyor..."
                                local walkTarget = Vector3.new(fieldCenter.X, hrp.Position.Y, fieldCenter.Z)
                                hum:MoveTo(walkTarget)
                            else
                                Stats.Status = "Yeni Tokenler Bekleniyor..."
                                hum:Move(Vector3.zero, false)
                            end
                        else
                            Stats.Status = "Token Bekleniyor..."
                            hum:Move(Vector3.zero, false)
                        end
                    end
                end
            end
        end

        -- Belirli aralıklarla UI güncellemesi
        if tick() - lastUiUpdate > 0.35 then
            lastUiUpdate = tick()
            updateStatusUI()
        end
    end
end)

-- Cleanup function
getgenv().AutoFarmTokenCleanup = function()
    running = false
    Config.Enabled = false
    isConverting = false
    hasTriggeredConvert = false
    Stats.Converting = false
    Stats.ConvertState = "IDLE"
    stopTween()
    local hum, _ = getCharacterComponents()
    if hum then
        hum:Move(Vector3.zero, false)
    end
    if menuInputConn then
        pcall(function() menuInputConn:Disconnect() end)
        menuInputConn = nil
    end
    if dragInputConn then
        pcall(function() dragInputConn:Disconnect() end)
        dragInputConn = nil
    end
    if sButtonGui then
        pcall(function() sButtonGui:Destroy() end)
        sButtonGui = nil
    end
    for _, data in pairs(starShowerDisks) do
        if data.tag then
            pcall(function() data.tag:Destroy() end)
        end
    end
    table.clear(starShowerDisks)
    pcall(function()
        Window:Destroy()
    end)
end

