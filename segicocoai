-- Helper: Scan for active combo coconut disks and differentiate between our field vs other fields
local function getComboCoconutsInfo(ourField)
    local particles = Workspace:FindFirstChild("Particles")
    if not particles then
        return nil, nil, false, 0
    end

    local ourCombo = nil
    local otherCombo = nil
    local anyComboExists = false
    local maxPoints = 0

    for _, obj in ipairs(particles:GetChildren()) do
        if obj:IsA("BasePart") and (obj.Name == "WarningDisk" or obj.Name == "AreaRing") then
            local guiAttach = obj:FindFirstChild("GuiAttach") or obj:FindFirstChildWhichIsA("BillboardGui", true)
            if guiAttach then
                local textLabel = guiAttach:FindFirstChildWhichIsA("TextLabel", true)
                if textLabel and textLabel.Text and (textLabel.Text:find("🥥") or textLabel.Text:find("x") or textLabel.Text:find("0")) then
                    anyComboExists = true
                    local points = tonumber(textLabel.Text:match("%d+")) or 0
                    if points > maxPoints then
                        maxPoints = points
                    end

                    local fieldName = getFieldNameAt(obj.Position)
                    local comboData = {
                        Position = obj.Position,
                        Text = textLabel.Text,
                        Field = fieldName,
                        Points = points,
                    }

                    local inOurField = false
                    if ourField and ourField ~= "Mevcut Konum (Otomatik)" then
                        inOurField = isInsideField(obj.Position, ourField)
                    elseif ourField == "Mevcut Konum (Otomatik)" then
                        local hum, hrp = getCharacterComponents()
                        if hrp then
                            local myField = getCurrentField()
                            if myField then
                                inOurField = isInsideField(obj.Position, myField)
                            else
                                inOurField = (obj.Position - hrp.Position).Magnitude <= Config.MaxDistance
                            end
                        end
                    end

                    if inOurField then
                        ourCombo = comboData
                    else
                        otherCombo = comboData
                    end
                end
            end
        end
    end

    return ourCombo, otherCombo, anyComboExists, maxPoints
end

-- ====================================================================
-- YERDEKİ STAR SHOWER YEŞİL HALKALARI (WARNINGDISK) SIRA SIRA TAKİP,
-- 3D SAYI SİSTEMİ & AKILLI YETİŞME KONTROLÜ (SMART REACHABILITY)
-- ====================================================================
local starShowerDisks = {} -- [BasePart] = { order = number, spawnTime = number, tag = BillboardGui, label = TextLabel, frame = Frame, stroke = UIStroke }
local showerCurrentSequence = 0
local showerLastStarTime = 0

local function isStarShowerDisk(obj)
    if not obj or not obj:IsA("BasePart") then return false end
    if obj.Name ~= "WarningDisk" then return false end

    -- Star Shower diskleri küçüktür (genellikle 8x0.4x8 stud, CylinderMesh)
    -- Coconut yeşil diskleri ise büyüktür (Size.X >= 12)
    if obj.Size.X >= 12 or obj.Size.Z >= 12 then return false end

    -- Yeşil Renk Kontrolü (Neon Green)
    local c = obj.Color
    local isGreen = (c.G > 0.6 and c.G > c.R and c.G > c.B) or (c.G * 255 >= 180 and c.R * 255 <= 120)
    if not isGreen then return false end

    -- Şeffaflaşmış/kaybolan diskleri yoksay
    if obj.Transparency >= 0.9 then return false end

    -- Hindistan cevizi combo disklerini (üzerinde 🥥 veya x yazanları) hariç tut
    local guiAttach = obj:FindFirstChild("GuiAttach") or obj:FindFirstChildWhichIsA("BillboardGui", true)
    if guiAttach then
        local textLabel = guiAttach:FindFirstChildWhichIsA("TextLabel", true)
        if textLabel and textLabel.Text and (textLabel.Text:find("🥥") or textLabel.Text:find("x")) then
            return false
        end
    end

    return true
end

-- Düşen yıldızların yerdeki yeşil halkalarını bulur, üzerlerine 3D sayı etiketi koyar,
-- ve yetişilebilecek en erken yıldızı akıllıca seçer!
local function getActiveStarShowerDisk(currentField)
    local hum, hrp = getCharacterComponents()
    if not hrp then return nil, nil end

    local particles = Workspace:FindFirstChild("Particles")
    if not particles then return nil, nil end

    local now = os.clock()

    -- Yeni bir Star Shower başladıysa (önceki yıldızdan bu yana 12 saniyeden fazla geçtiyse) sayacı sıfırla
    if now - showerLastStarTime > 12.0 then
        showerCurrentSequence = 0
    end

    -- 1. Particles klasöründeki yeni yeşil diskleri tespit et ve 3D sayı etiketini oluştur
    for _, obj in ipairs(particles:GetChildren()) do
        if isStarShowerDisk(obj) then
            if not starShowerDisks[obj] then
                showerLastStarTime = now
                showerCurrentSequence = showerCurrentSequence + 1
                local diskOrder = showerCurrentSequence

                local tag = Instance.new("BillboardGui")
                tag.Name = "StarShowerNumberTag"
                tag.Adornee = obj
                tag.Size = UDim2.fromOffset(84, 40)
                tag.StudsOffsetWorldSpace = Vector3.new(0, 4.2, 0)
                tag.AlwaysOnTop = true
                tag.MaxDistance = 350

                local frame = Instance.new("Frame")
                frame.Name = "Bg"
                frame.Size = UDim2.fromScale(1, 1)
                frame.BackgroundColor3 = Color3.fromRGB(25, 23, 45)
                frame.BackgroundTransparency = 0.12
                frame.BorderSizePixel = 0
                frame.Parent = tag
                Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 8)

                local stroke = Instance.new("UIStroke")
                stroke.Thickness = 2
                stroke.Color = Color3.fromRGB(90, 170, 255)
                stroke.Parent = frame

                local label = Instance.new("TextLabel")
                label.Name = "NumLabel"
                label.Size = UDim2.fromScale(1, 1)
                label.BackgroundTransparency = 1
                label.TextColor3 = Color3.fromRGB(255, 230, 80)
                label.Font = Enum.Font.GothamBold
                label.TextSize = 15
                label.Text = string.format("⭐ %d", diskOrder)
                label.Parent = frame

                tag.Parent = LocalPlayer:WaitForChild("PlayerGui")

                starShowerDisks[obj] = {
                    order = diskOrder,
                    spawnTime = now,
                    tag = tag,
                    label = label,
                    frame = frame,
                    stroke = stroke,
                }
            end
        end
    end

    -- 2. Silinen veya süresi dolan diskleri temizle
    local validDisks = {}
    for disk, data in pairs(starShowerDisks) do
        if not disk.Parent or disk.Parent ~= particles or not isStarShowerDisk(disk) or disk.Transparency >= 0.9 then
            if data.tag then
                pcall(function() data.tag:Destroy() end)
            end
            starShowerDisks[disk] = nil
        else
            local inField = true
            if Config.LockToField and currentField and currentField ~= "Mevcut Konum (Otomatik)" then
                inField = isInsideField(disk.Position, currentField)
            end

            local distToPlayer = (disk.Position - hrp.Position).Magnitude
            if inField and distToPlayer <= (Config.MaxDistance or 180) then
                table.insert(validDisks, { disk = disk, data = data, dist = distToPlayer })
            end
        end
    end

    if #validDisks == 0 then return nil, nil end

    -- 3. Sayı sırasına (1, 2, 3...) göre sırala ve doğrudan sıradaki yıldızı hedef al
    table.sort(validDisks, function(a, b)
        return a.data.order < b.data.order
    end)

    local targetItem = validDisks[1]

    -- 3D Etiketleri Canlı Olarak Güncelle
    for _, item in ipairs(validDisks) do
        pcall(function()
            if item.disk == targetItem.disk then
                item.data.label.Text = string.format("⭐ %d [HEDEF]", item.data.order)
                item.data.label.TextColor3 = Color3.fromRGB(120, 255, 150)
                item.data.stroke.Color = Color3.fromRGB(120, 255, 150)
                item.data.frame.BackgroundColor3 = Color3.fromRGB(30, 60, 42)
            else
                item.data.label.Text = string.format("⭐ %d", item.data.order)
                item.data.label.TextColor3 = Color3.fromRGB(255, 230, 80)
                item.data.stroke.Color = Color3.fromRGB(90, 170, 255)
                item.data.frame.BackgroundColor3 = Color3.fromRGB(25, 23, 45)
            end
        end)
    end

    return targetItem.disk, targetItem.data.order
end

-- Helper: Find Active Normal Coconut Disks (Large Green Disks, Size.X >= 12) inside active field
local function getActiveCoconutDisk(currentField)
    local hum, hrp = getCharacterComponents()
    if not hrp then return nil end

    local particles = Workspace:FindFirstChild("Particles")
    if not particles then return nil end

    local bestPos = nil
    local shortestDist = math.huge

    for _, obj in ipairs(particles:GetChildren()) do
        if obj:IsA("BasePart") and (obj.Name == "WarningDisk" or (obj.Name == "AreaRing" and obj.Color.G > 0.65)) then
            if obj.Size.X >= 12 or obj.Name == "AreaRing" then
                local guiAttach = obj:FindFirstChild("GuiAttach") or obj:FindFirstChildWhichIsA("BillboardGui", true)
                local isCombo = false
                if guiAttach then
                    local textLabel = guiAttach:FindFirstChildWhichIsA("TextLabel", true)
                    if textLabel and textLabel.Text and (textLabel.Text:find("🥥") or textLabel.Text:find("x") or textLabel.Text:find("0")) then
                        isCombo = true
                    end
                end

                if not isCombo then
                    local inField = true
                    if Config.LockToField and currentField and currentField ~= "Mevcut Konum (Otomatik)" then
                        inField = isInsideField(obj.Position, currentField)
                    end

                    if inField then
                        local dist = (obj.Position - hrp.Position).Magnitude
                        if dist <= Config.MaxDistance and dist < shortestDist then
                            shortestDist = dist
                            bestPos = obj.Position
                        end
                    end
                end
            end
        end
    end

    return bestPos
end

-- ====================================================================
-- TWEEN MOTORLARI (SAFE TWEEN & YEREL KESİNTİSİZ TWEEN)
-- ====================================================================
local activeTween = nil

local function stopTween()
    if activeTween then
        pcall(function()
            activeTween:Cancel()
        end)
        activeTween = nil
    end
    Stats.IsTweening = false
    local hum, hrp = getCharacterComponents()
    if hrp then
        for _, obj in ipairs(hrp:GetChildren()) do
            if obj:IsA("BodyVelocity") or obj:IsA("BodyGyro") then
                pcall(function() obj:Destroy() end)
            end
        end
        hrp.Velocity = Vector3.zero
    end
end

-- Karakterin Ragdoll'a girmesini önleyen ve zıplamayı her zaman aktif tutan koruyucu fonksiyon
local function applyAntiRagdollStates(hum)
    if not hum then return end
    pcall(function()
        hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
        hum:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)
        hum:SetStateEnabled(Enum.HumanoidStateType.Freefall, true)
        hum:SetStateEnabled(Enum.HumanoidStateType.Jumping, true)
        hum:SetStateEnabled(Enum.HumanoidStateType.Running, true)
        hum:SetStateEnabled(Enum.HumanoidStateType.GettingUp, true)
    end)
end

-- Genel SafeTween (Tarlalar arası uzun mesafeli düz süzülme)
local function safeTweenTo(targetPos, onComplete)
    local hum, hrp = getCharacterComponents()
    if not hum or not hrp or not targetPos then return end

    stopTween()
    Stats.IsTweening = true

    pcall(function()
        hum:Move(Vector3.zero, false)
        applyAntiRagdollStates(hum)
        hum:ChangeState(Enum.HumanoidStateType.Running)
    end)

    local startPos = hrp.Position
    local dist = (startPos - targetPos).Magnitude

    local bv = Instance.new("BodyVelocity")
    bv.Velocity = Vector3.zero
    bv.MaxForce = Vector3.new(1e6, 1e6, 1e6)
    bv.Parent = hrp

    local dir = (targetPos - startPos)
    local flatDir = Vector3.new(dir.X, 0, dir.Z)
    if flatDir.Magnitude < 0.1 then flatDir = hrp.CFrame.LookVector else flatDir = flatDir.Unit end
    local targetCF = CFrame.lookAt(targetPos, targetPos + flatDir)

    local speed = Config.TweenSpeed or 95
    local duration = math.clamp(dist / speed, 0.2, 35)

    local tweenInfo = TweenInfo.new(duration, Enum.EasingStyle.Linear)
    local tw = TweenService:Create(hrp, tweenInfo, { CFrame = targetCF })
    activeTween = tw

    tw.Completed:Connect(function(playbackState)
        if activeTween == tw then
            activeTween = nil
            Stats.IsTweening = false
        end
        pcall(function() bv:Destroy() end)
        applyAntiRagdollStates(hum)
        hrp.Velocity = Vector3.zero
        hum:Move(Vector3.zero, false)
        if playbackState == Enum.PlaybackState.Completed and onComplete then
            onComplete()
        end
    end)

    tw:Play()
end

-- Zemin Seviyesi Halka Tween'i (Normal Coconut veya Combo Halkası için)
local function tweenToGroundTarget(targetPos, customSpeed)
    local hum, hrp = getCharacterComponents()
    if not hum or not hrp or not targetPos then return end

    local startPos = hrp.Position
    local endPos = Vector3.new(targetPos.X, hrp.Position.Y, targetPos.Z)
    local dist = (startPos - endPos).Magnitude
    if dist < 2.0 then
        hum:Move(Vector3.zero, false)
        hrp.Velocity = Vector3.zero
        return
    end

    Stats.IsTweening = true

    pcall(function()
        hum:Move(Vector3.zero, false)
        applyAntiRagdollStates(hum)
        hum:ChangeState(Enum.HumanoidStateType.Running)
    end)

    local bv = Instance.new("BodyVelocity")
    bv.Velocity = Vector3.zero
    bv.MaxForce = Vector3.new(1e6, 1e6, 1e6)
    bv.Parent = hrp

    local dir = (endPos - startPos)
    local flatDir = Vector3.new(dir.X, 0, dir.Z)
    if flatDir.Magnitude < 0.1 then flatDir = hrp.CFrame.LookVector else flatDir = flatDir.Unit end
    local targetCF = CFrame.lookAt(endPos, endPos + flatDir)

    local speed = customSpeed or Config.TweenSpeed or 95
    local duration = math.clamp(dist / speed, 0.04, 3.5)

    local tw = TweenService:Create(hrp, TweenInfo.new(duration, Enum.EasingStyle.Linear), { CFrame = targetCF })
    tw:Play()
    tw.Completed:Wait()

    pcall(function() bv:Destroy() end)
    applyAntiRagdollStates(hum)
    hrp.Velocity = Vector3.zero
    hum:Move(Vector3.zero, false)
    Stats.IsTweening = false
end

-- Özel Star Shower Kesilebilir & Merkeze Oturan Tween Motoru
-- Halka yok olursa veya yıldız erken düşerse anında iptal olur; boşa uçmayı engeller!
local function tweenToStarShowerTarget(disk, targetPos, customSpeed)
    local hum, hrp = getCharacterComponents()
    if not hum or not hrp or not targetPos or not disk or not disk.Parent then return false end

    local startPos = hrp.Position
    local dist = (startPos - targetPos).Magnitude
    local currentLook = hrp.CFrame.LookVector
    local flatLook = Vector3.new(currentLook.X, 0, currentLook.Z)
    if flatLook.Magnitude < 0.05 then flatLook = Vector3.new(0, 0, -1) else flatLook = flatLook.Unit end

    if dist <= 2.2 then
        hrp.CFrame = CFrame.lookAt(targetPos, targetPos + flatLook)
        hrp.Velocity = Vector3.zero
        hum:Move(Vector3.zero, false)
        return true
    end

    Stats.IsTweening = true

    pcall(function()
        hum:Move(Vector3.zero, false)
        applyAntiRagdollStates(hum)
        hum:ChangeState(Enum.HumanoidStateType.Running)
    end)

    local bv = Instance.new("BodyVelocity")
    bv.Velocity = Vector3.zero
    bv.MaxForce = Vector3.new(1e6, 1e6, 1e6)
    bv.Parent = hrp

    local dir = (targetPos - startPos)
    local flatDir = Vector3.new(dir.X, 0, dir.Z)
    if flatDir.Magnitude < 0.1 then flatDir = flatLook else flatDir = flatDir.Unit end
    local targetCF = CFrame.lookAt(targetPos, targetPos + flatDir)

    local speed = customSpeed or Config.StarShowerTweenSpeed or 140
    local duration = math.clamp(dist / speed, 0.04, 3.0)

    local tw = TweenService:Create(hrp, TweenInfo.new(duration, Enum.EasingStyle.Linear), { CFrame = targetCF })
    tw:Play()

    local arrived = false
    while tw.PlaybackState == Enum.PlaybackState.Playing do
        -- Yıldız düştüyse veya disk yok olduysa havada boşa uçma, hemen kes!
        if not disk.Parent or disk.Transparency >= 0.9 then
            tw:Cancel()
            break
        end
        -- Tam merkeze yaklaştıysak tweeni bitir ve tam merkeze otur
        if (hrp.Position - targetPos).Magnitude <= 2.2 then
            tw:Cancel()
            arrived = true
            break
        end
        task.wait(0.015)
    end

    pcall(function() bv:Destroy() end)
    applyAntiRagdollStates(hum)
    hrp.Velocity = Vector3.zero
    hum:Move(Vector3.zero, false)
    Stats.IsTweening = false

    if arrived or (hrp.Position - targetPos).Magnitude <= 2.5 then
        hrp.CFrame = CFrame.lookAt(targetPos, targetPos + flatDir)
        return true
    end
    return false
end

