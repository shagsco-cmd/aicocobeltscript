-- Persistent Configuration (Save / Load) System
-- ====================================================================
local CONFIG_FOLDER = "AutoFarmToken_BSS"
local CONFIG_FILE = CONFIG_FOLDER .. "/config.json"

local function saveConfig()
    if not (writefile and HttpService) then return false end
    local success = pcall(function()
        if makefolder and isfolder and not isfolder(CONFIG_FOLDER) then
            makefolder(CONFIG_FOLDER)
        end
        local saveTable = {}
        for k, defaultVal in pairs(DEFAULT_CONFIG) do
            if Config[k] ~= nil then
                saveTable[k] = Config[k]
            else
                saveTable[k] = defaultVal
            end
        end
        local json = HttpService:JSONEncode(saveTable)
        writefile(CONFIG_FILE, json)
    end)
    return success
end

local function loadConfig()
    if not (readfile and isfile and HttpService and isfile(CONFIG_FILE)) then
        return false
    end
    local success, data = pcall(function()
        local content = readfile(CONFIG_FILE)
        return HttpService:JSONDecode(content)
    end)
    if success and type(data) == "table" then
        for k, defaultVal in pairs(DEFAULT_CONFIG) do
            if data[k] ~= nil and type(data[k]) == type(defaultVal) then
                Config[k] = data[k]
            end
        end
        return true
    end
    return false
end

