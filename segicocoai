-- ====================================================================
-- Persistent Configuration (Save / Load) System
-- ====================================================================
local CONFIG_FOLDER = "AutoFarmToken_BSS"
local CONFIG_FILE = CONFIG_FOLDER .. "/config.json"

local function saveConfig()
    if not (writefile and HttpService) then return false end
    local ok, err = pcall(function()
        if not isfolder(CONFIG_FOLDER) then
            makefolder(CONFIG_FOLDER)
        end
        local dataToSave = {}
        for k, _ in pairs(DEFAULT_CONFIG) do
            dataToSave[k] = Config[k]
        end
        local json = HttpService:JSONEncode(dataToSave)
        writefile(CONFIG_FILE, json)
    end)
    return ok
end

local function loadConfig()
    if not (readfile and isfile and HttpService) then return false end
    if not isfile(CONFIG_FILE) then return false end

    local ok, res = pcall(function()
        local raw = readfile(CONFIG_FILE)
        local data = HttpService:JSONDecode(raw)
        if type(data) == "table" then
            for k, defaultVal in pairs(DEFAULT_CONFIG) do
                if data[k] ~= nil then
                    Config[k] = data[k]
                else
                    Config[k] = defaultVal
                end
            end
            return true
        end
        return false
    end)
    return ok and res
end

