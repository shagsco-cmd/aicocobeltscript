-- Helper: Check if a position is inside a specific field
local function isInsideField(pos, fieldName)
    if not fieldName or fieldName == "Mevcut Konum (Otomatik)" then
        if Config.AnchorPosition then
            return (pos - Config.AnchorPosition).Magnitude <= Config.MaxDistance
        end
        return true
    end

    if not FlowerZonesFolder then return true end
    local fieldPart = FlowerZonesFolder:FindFirstChild(fieldName)
    if not fieldPart or not fieldPart:IsA("BasePart") then return true end

    local localPos = fieldPart.CFrame:PointToObjectSpace(pos)
    local half = fieldPart.Size / 2
    return math.abs(localPos.X) <= (half.X + 8) and math.abs(localPos.Z) <= (half.Z + 8)
end

-- Helper: Format numbers to clean readable strings (K, M, B, T)
local function formatNumber(n)
    if not n or n <= 0 then return "0" end
    if n >= 1e12 then
        return string.format("%.2fT", n / 1e12)
    elseif n >= 1e9 then
        return string.format("%.2fB", n / 1e9)
    elseif n >= 1e6 then
        return string.format("%.2fM", n / 1e6)
    elseif n >= 1e3 then
        return string.format("%.1fK", n / 1e3)
    else
        return string.format("%.0f", n)
    end
end

-- Helper: Find Player's Claimed Hive & Standing Platform Position
local function getPlayerHive()
    local honeycombs = Workspace:FindFirstChild("Honeycombs")
    if not honeycombs then return nil, nil end
    local lp = Players.LocalPlayer
    if not lp then return nil, nil end

    for _, hc in ipairs(honeycombs:GetChildren()) do
        local owner = hc:FindFirstChild("Owner")
        if owner and (owner.Value == lp or tostring(owner.Value) == lp.Name) then
            local spawnPos = hc:FindFirstChild("SpawnPos")
            local platform = hc:FindFirstChild("Platform")
            local targetPos = nil
            if spawnPos and spawnPos:IsA("CFrameValue") then
                targetPos = spawnPos.Value.Position
            elseif platform and platform.Value and platform.Value:IsA("Model") then
                local pp = platform.Value.PrimaryPart or platform.Value:FindFirstChildWhichIsA("BasePart", true)
                if pp then
                    targetPos = pp.Position + Vector3.new(0, 3.5, 0)
                end
            end
            return hc, targetPos
        end
    end
    return nil, nil
end

