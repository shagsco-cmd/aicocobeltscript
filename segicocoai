    pcall(function()
        StatusParagraph:SetDesc(descText)
    end)

    local comboInfo = (maxComboSeen > 0 and string.format(" (Max: %dx)", maxComboSeen)) or ""
    local comboSpeedText = (Config.ComboMovementMode == "Anında Işınlanma (TP)" and "Anında TP") or string.format("Tween (%d stud/s)", Config.ComboTweenSpeed or Config.TweenSpeed or 95)
